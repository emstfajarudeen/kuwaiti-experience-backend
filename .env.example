TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info
APP_KEY=replace-with-random-32-character-secret
APP_URL=http://localhost:3333
CORS_ORIGINS=https://thekuwaitiexperience.com
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kuwaitiexperience
DB_PASSWORD=replace-with-database-password
DB_DATABASE=kuwaitiexperience_dev
DB_DEBUG=false
JWT_SECRET=replace-with-an-independent-random-32-character-secret
JWT_ISSUER=kuwaitiexperience
JWT_AUDIENCE=kuwaitiexperience-admin
LIMITER_STORE=database
# Phone OTP requires an independent random secret of at least 32 characters.
# CUSTOMER_OTP_SECRET=
# Local development only: return the code as data.dev_otp instead of sending SMS.
# This has no effect unless NODE_ENV=development. Never enable it with real customer data.
# CUSTOMER_OTP_DEV_RESPONSE=false
# Production SMS delivery adapter:
# SMS_WEBHOOK_URL=https://your-sms-adapter.example/send
# SMS_WEBHOOK_TOKEN=
# Required only when running the admin seeder for the first time:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=enter-a-strong-unique-password
