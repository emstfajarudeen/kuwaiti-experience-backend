TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info
APP_KEY=replace-with-random-32-character-secret
APP_URL=http://localhost:3333
CORS_ORIGINS=https://thekuwaitiexperience.com
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kuwaitiexperience
DB_PASSWORD=replace-with-database-password
DB_DATABASE=kuwaitiexperience_dev
DB_DEBUG=false
JWT_SECRET=replace-with-an-independent-random-32-character-secret
JWT_ISSUER=kuwaitiexperience
JWT_AUDIENCE=kuwaitiexperience-admin
LIMITER_STORE=database
# Phone OTP requires an independent random secret of at least 32 characters.
# CUSTOMER_OTP_SECRET=
# Temporary opt-in for development or staging servers: skip SMS and verify OTP challenges with fixed code 2580.
# The code is never returned in API responses.
# This mode allows 10 OTP requests per phone per minute with no resend cooldown.
# This also works when NODE_ENV=production; keep it off for real customer traffic.
# CUSTOMER_OTP_DEV_RESPONSE=false
# Production SMS delivery adapter:
# SMS_WEBHOOK_URL=https://your-sms-adapter.example/send
# SMS_WEBHOOK_TOKEN=
# SMTP delivery for CMS password-reset emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ADMIN_PASSWORD_RESET_FROM=The Kuwaiti Experience <no-reply@example.com>
# Required only when running the admin seeder for the first time:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=enter-a-strong-unique-password
