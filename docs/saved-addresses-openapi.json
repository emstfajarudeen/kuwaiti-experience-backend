{
  "openapi": "3.1.0",
  "info": {
    "title": "Kuwaiti Experience Saved Addresses API",
    "version": "2.0.0",
    "description": "Private customer address book. Address text and map coordinates are supplied by the app. User-entered text is not translated. Deleting an account cascades saved addresses. All responses use Cache-Control: no-store."
  },
  "paths": {
    "/api/v2/customer/me/saved-addresses": {
      "get": {
        "summary": "List my saved addresses, newest first",
        "tags": [
          "Saved addresses"
        ],
        "security": [
          {
            "customerBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressList"
                }
              }
            }
          },
          "401": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 12
            }
          }
        ]
      },
      "post": {
        "summary": "Save an address",
        "tags": [
          "Saved addresses"
        ],
        "security": [
          {
            "customerBearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressResult"
                }
              }
            }
          },
          "401": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAddress"
              }
            }
          }
        }
      }
    },
    "/api/v2/customer/me/saved-addresses/{id}": {
      "get": {
        "summary": "Read my saved address",
        "tags": [
          "Saved addresses"
        ],
        "security": [
          {
            "customerBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressResult"
                }
              }
            }
          },
          "401": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "patch": {
        "summary": "Update my saved address; omitted fields retain their values",
        "tags": [
          "Saved addresses"
        ],
        "security": [
          {
            "customerBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressResult"
                }
              }
            }
          },
          "401": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAddress"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete my saved address; missing or other-account IDs return 404",
        "tags": [
          "Saved addresses"
        ],
        "security": [
          {
            "customerBearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted; empty body"
          },
          "401": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Standard API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./customer-openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "customerBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Customer access token"
      }
    },
    "schemas": {
      "SavedAddress": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "customer_id",
          "label",
          "address",
          "latitude",
          "longitude",
          "notes",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "customer_id": {
            "type": "integer"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "Home"
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CreateAddress": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "address",
          "latitude",
          "longitude"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "Home"
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      },
      "UpdateAddress": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "Home"
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        },
        "minProperties": 1
      },
      "AddressResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SavedAddress"
          }
        }
      },
      "AddressList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SavedAddress"
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "per_page",
              "total",
              "last_page"
            ],
            "properties": {
              "page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "last_page": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
