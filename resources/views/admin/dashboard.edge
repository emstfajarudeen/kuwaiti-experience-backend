@layouts.admin({ title: 'Overview', active: 'dashboard', adminName: admin.fullName })
  <div class="page-head">
    <div>
      <h1>Overview</h1>
    </div>
    <div class="page-head-actions">
      <a class="button primary" href="/admin/places/new">+ Add place</a>
    </div>
  </div>
  <!--Primary Metric Status Cards-->
  <div class="overview-stats">
    <a href="/admin/places" class="stat-card accent">
      <span class="stat-label">Total Places</span>
      <strong class="stat-value">{{ totalPlaces }}</strong>
    </a>
    <a href="/admin/places?status=published" class="stat-card">
      <span class="stat-label">Published</span>
      <strong class="stat-value" style="color: var(--success-text);">{{ publishedCount }}</strong>
    </a>
    <a href="/admin/places?status=draft" class="stat-card">
      <span class="stat-label">Drafts</span>
      <strong class="stat-value" style="color: var(--warning-text);">{{ draftCount }}</strong>
    </a>
    <a href="/admin/places?status=archived" class="stat-card">
      <span class="stat-label">Archived</span>
      <strong class="stat-value" style="color: var(--danger-text);">{{ archivedCount }}</strong>
    </a>
  </div>
  <!--Attention Area-->
  <div class="attention-grid">
    <div class="attention-card {{ draftCount > 0 ? 'urgent' : '' }}">
      <div class="attention-content">
        <h3>Draft Places</h3>
        <p>{{ draftCount }} {{ draftCount === 1 ? 'place' : 'places' }} in draft mode</p>
      </div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <span class="attention-badge">{{ draftCount }}</span>
        <a
          href="/admin/places?status=draft"
          class="button secondary"
          style="min-height: 36px; padding: 6px 14px;"
        >
          Review drafts
        </a>
      </div>
    </div>

    <div class="attention-card {{ newContactsCount > 0 ? 'urgent' : '' }}">
      <div class="attention-content">
        <h3>Contact Requests</h3>
        <p>{{ newContactsCount }} new {{ newContactsCount === 1 ? 'message' : 'messages' }}</p>
      </div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <span class="attention-badge">{{ newContactsCount }}</span>
        <a
          href="/admin/contact-requests"
          class="button secondary"
          style="min-height: 36px; padding: 6px 14px;"
        >
          View inbox
        </a>
      </div>
    </div>
  </div>
  <!--Category Type Distribution-->
  @if(typeBreakdown && typeBreakdown.length)
    <section class="panel type-chips-panel">
      <div
        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;"
      >
        <h2 style="font-size: 16px; margin: 0;">Place types</h2>
        <a href="/admin/category-types" class="text-button" style="font-size: 13px;">
          Manage types
        </a>
      </div>
      <div class="type-chips-grid">
        @each(type in typeBreakdown)
          <a href="/admin/places?type={{ type.code }}" class="type-chip">
            <span>{{ type.name }}</span>
            <span class="type-chip-count">{{ type.count }}</span>
          </a>
        @end
      </div>
    </section>
  @end
  <!--Recent Activity & Editorial Tasks-->
  <div class="content-grid">
    <section class="panel">
      <div class="panel-heading">
        <h2>Latest activity</h2>
      </div>
      @if(recent && recent.length)
        <div class="activity-list">
          @each(event in recent)
            <div class="activity-item">
              <span class="activity-icon" aria-hidden="true">✎</span>
              <div class="activity-info">
                <strong>{{ event.actionLabel }}</strong>
                <small>
                  @if(event.editUrl && !event.isDeleted)
                    <a href="{{ event.editUrl }}">{{ event.entityName }}</a>
                  @else
                    <span style="color: var(--ink-secondary);">{{ event.entityName }}</span>
                    @if(event.isDeleted)
                      <span
                        class="status archived"
                        style="font-size: 10px; padding: 2px 6px; margin-left: 6px;"
                      >
                        Deleted
                      </span>
                    @end
                  @end
                </small>
              </div>
              <time class="activity-time">{{ event.created_at }}</time>
            </div>
          @end
        </div>
      @else
        <div class="empty-state">
          <p>No recent activity recorded.</p>
        </div>
      @end
    </section>

    <section class="panel">
      <div class="panel-heading">
        <h2>Quick tasks</h2>
      </div>
      <div class="quick-links-group">
        <a href="/admin/places/new" class="quick-link-item"><span>Add new place</span></a>
        <a href="/admin/places" class="quick-link-item"><span>Places</span></a>
        <a href="/admin/category-types" class="quick-link-item"><span>Category types</span></a>
        <a href="/admin/categories" class="quick-link-item"><span>Categories</span></a>
        <a href="/admin/place-features" class="quick-link-item"><span>Place features</span></a>
        <a href="/admin/contact-requests" class="quick-link-item"><span>Contact inbox</span></a>
        <a href="/admin/settings" class="quick-link-item"><span>Settings</span></a>
      </div>
    </section>
  </div>
@end
