@let(form = flashMessages.get('homeForm') || {})
@let(cardForm = flashMessages.get('homeCardForm') || {})
@layouts.admin({ title: 'Homepage', active: 'home', adminName: admin.fullName })
  <div class="page-head">
    <div>
      <h1>Homepage</h1>
    </div>
  </div>

  <!-- Locale Filter Switcher -->
  <div class="filter-pills">
    <a href="/admin/home?locale=en" class="{{ locale === 'en' ? 'selected' : '' }}">English</a>
    <a href="/admin/home?locale=ar" class="{{ locale === 'ar' ? 'selected' : '' }}">العربية (Arabic)</a>
  </div>

  @form({ action: '/admin/home', method: 'POST', enctype: 'multipart/form-data', class: 'editor-grid' })
    <input type="hidden" name="locale" value="{{ locale }}" />

    <div class="editor-main">
      <!-- Hero Section -->
      <section class="panel form-panel">
        <h2>Hero headline &amp; image</h2>

        <div class="form-grid" style="margin-top: 16px;">
          <label>
            Hero eyebrow
            <input name="hero_eyebrow" value="{{ form.hero_eyebrow ?? home?.hero_eyebrow ?? 'WELCOME TO KUWAIT' }}" required />
          </label>

          <label>
            Hero headline
            <input name="hero_title" value="{{ form.hero_title ?? home?.hero_title ?? 'Explore Kuwait' }}" required />
          </label>

          <div class="image-field" style="margin-top: 8px;">
            <span style="font-size: 13px; font-weight: 600; color: var(--ink-secondary);">
              Hero image ({{ locale === 'ar' ? 'Arabic' : 'English' }})
            </span>

            @if(heroImageUrl)
              <div style="margin: 8px 0;">
                <img
                  class="cover-preview"
                  src="{{ heroImageUrl }}"
                  alt="Current hero image"
                  style="max-height: 220px;"
                />
              </div>
            @end

            <div class="image-upload">
              <span style="display: block; font-weight: 600; margin-bottom: 6px;">
                {{ heroImageUrl ? 'Replace hero image' : 'Upload hero image' }}
              </span>
              <input
                type="file"
                name="heroImage"
                accept="image/jpeg,image/png,image/webp"
                aria-label="Hero image"
                data-image-upload
              />
            </div>

            @if(heroImageUrl)
              <label class="checkbox-line" style="margin-top: 8px;">
                <input type="checkbox" name="removeHeroImage" /> Remove hero image
              </label>
            @end
          </div>
        </div>
      </section>

      <!-- Discovery Section -->
      <section class="panel form-panel">
        <h2>Category headline &amp; app promo</h2>

        <div class="form-grid" style="margin-top: 16px;">
          <label>
            Discovery section headline
            <input name="discovery_title" value="{{ form.discovery_title ?? home?.discovery_title ?? 'What would you like to do?' }}" required />
          </label>

          <label>
            Mobile app banner title
            <input name="app_title" value="{{ form.app_title ?? home?.app_title ?? '' }}" placeholder="Take Kuwait with you" />
          </label>

          <label class="full">
            Mobile app banner description
            <textarea name="app_body" rows="3" placeholder="App description...">{{ form.app_body ?? home?.app_body ?? '' }}</textarea>
          </label>
        </div>
      </section>
    </div>

    <!-- Aside Save Actions -->
    <aside class="editor-aside">
      <section class="panel form-panel actions-panel">
        <h2>Publishing</h2>
        <div class="save-controls-stack" style="margin-top: 16px;">
          <button class="button primary wide" type="submit">
            Save homepage
          </button>
        </div>
      </section>
    </aside>
  @end

  <!-- Place Stories / Home Explore Cards Section -->
  <section class="panel form-panel" id="home-cards" style="margin-top: 24px;">
    <h2>Place stories</h2>

    <!-- Existing Cards -->
    @if(cards && cards.length)
      <div style="display: flex; flex-direction: column; gap: 16px; margin-top: 20px;">
        @each(card in cards)
          <div class="panel" style="margin-bottom: 0; box-shadow: none; border: 1px solid var(--line); padding: 18px; background: var(--surface-subtle);">
            @form({ action: '/admin/home/cards/' + card.id + '/save', method: 'POST', class: 'form-grid two' })
              <label class="full">
                Venue
                <select name="place_id" required>
                  @each(place in places)
                    <option value="{{ place.id }}" @if(place.id === card.place_id) selected @end>
                      {{ place.title }} — {{ place.type }} ({{ place.status }})
                    </option>
                  @end
                </select>
              </label>

              <label>
                English caption
                <input name="caption_en" maxlength="200" value="{{ card.caption_en || '' }}" placeholder="Custom caption" />
              </label>

              <label>
                Arabic caption
                <input name="caption_ar" maxlength="200" dir="rtl" value="{{ card.caption_ar || '' }}" placeholder="تعليق مخصص" />
              </label>

              <label>
                Display order
                <input name="sort_order" type="number" min="0" max="9999" value="{{ card.sort_order }}" required />
              </label>

              <div style="display: flex; align-items: center; margin-top: 14px;">
                <label class="checkbox-line">
                  <input type="checkbox" name="active" @if(card.active) checked @end />
                  Visible when venue is published
                </label>
              </div>

              <div class="full" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--line); padding-top: 12px; margin-top: 8px;">
                <button class="button secondary" type="submit">Save card</button>
              </div>
            @end

            <div style="margin-top: 8px; text-align: right;">
              @form({ action: '/admin/home/cards/' + card.id + '/delete', method: 'POST', 'data-confirm': 'Remove this place card from the homepage?' })
                <button class="text-button danger" type="submit">Remove card</button>
              @end
            </div>
          </div>
        @end
      </div>
    @end

    <!-- Add New Card Form -->
    <div style="margin-top: 28px; border-top: 1px solid var(--line); padding-top: 20px;">
      <h3 style="font-size: 16px; margin: 0 0 14px;">Add a place story card</h3>
      @form({ action: '/admin/home/cards', method: 'POST', class: 'form-grid two' })
        <label class="full">
          Choose venue
          <select name="place_id" required>
            <option value="">Select a place...</option>
            @each(place in places)
              <option value="{{ place.id }}" @if(String(cardForm.place_id) === String(place.id)) selected @end>
                {{ place.title }} — {{ place.type }} ({{ place.status }})
              </option>
            @end
          </select>
        </label>

        <label>
          English caption
          <input name="caption_en" maxlength="200" value="{{ cardForm.caption_en ?? '' }}" placeholder="Card caption" />
        </label>

        <label>
          Arabic caption
          <input name="caption_ar" maxlength="200" dir="rtl" value="{{ cardForm.caption_ar ?? '' }}" placeholder="تعليق بالعربية" />
        </label>

        <label>
          Display order
          <input name="sort_order" type="number" min="0" max="9999" value="{{ cardForm.sort_order ?? 0 }}" required />
        </label>

        @let(isCardActive = cardForm.active !== undefined ? cardForm.active === 'on' : true)
        <div style="display: flex; align-items: center; margin-top: 14px;">
          <label class="checkbox-line">
            <input type="checkbox" name="active" @if(isCardActive) checked @end />
            Visible when venue is published
          </label>
        </div>

        <div class="full" style="margin-top: 8px;">
          <button class="button primary" type="submit">
            Add story card
          </button>
        </div>
      @end
    </div>
  </section>
@end
