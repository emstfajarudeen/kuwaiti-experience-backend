@layouts.admin({ title: 'Pages', active: 'pages', adminName: admin.fullName })
  <div class="page-head">
    <div>
      <h1>Pages</h1>
    </div>
    <div class="page-head-actions">
      <a class="button primary" href="/admin/pages/new">+ Create page</a>
    </div>
  </div>

  <section class="panel table-panel">
    <div class="panel-heading">
      <h2>Pages ({{ rows.length }})</h2>
    </div>
    @if(rows && rows.length)
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Page Title</th>
              <th scope="col">Public URL</th>
              <th scope="col">Status</th>
              <th scope="col" style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            @each(page in rows)
              <tr>
                <td>
                  <div class="place-title-wrap">
                    <strong>{{ page.title || 'Untitled page' }}</strong>
                  </div>
                </td>
                <td><code>/{{ page.slug }}</code></td>
                <td><span class="status {{ page.status }}">{{ page.status }}</span></td>
                <td style="text-align: right;">
                  <a class="button secondary table-action" href="/admin/pages/{{ page.id }}/edit">
                    Edit
                  </a>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      <div class="empty-state">
        <p>No content pages created yet.</p>
        <a href="/admin/pages/new">Create page</a>
      </div>
    @end
  </section>
@end
