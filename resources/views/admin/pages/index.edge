@layouts.admin({ title: 'Pages', active: 'pages', adminName: admin.fullName })
  <div class="page-head">
    <div>
      <h1>Pages</h1>
    </div>
    <div class="page-head-actions">
      <a class="button primary" href="/admin/pages/new">+ Create page</a>
    </div>
  </div>

  <section class="panel table-panel">
    <div class="panel-heading">
      <h2>Pages ({{ rows.length }})</h2>
    </div>
    @if(rows && rows.length)
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col" class="th-edit" aria-label="Edit"></th>
              <th scope="col">Page Title</th>
              <th scope="col">Public URL</th>
              <th scope="col">Status</th>
              <th scope="col" class="th-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            @each(page in rows)
              <tr>
                <td class="td-edit">
                  <a
                    href="/admin/pages/{{ page.id }}/edit"
                    class="action-pencil-btn"
                    title="Edit {{ page.title || 'page' }}"
                    aria-label="Edit {{ page.title || 'page' }}"
                  >
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                      <path d="m15 5 4 4" />
                    </svg>
                  </a>
                </td>
                <td>
                  <div class="place-title-wrap">
                    <strong>{{ page.title || 'Untitled page' }}</strong>
                  </div>
                </td>
                <td><code>/{{ page.slug }}</code></td>
                <td><span class="status {{ page.status }}">{{ page.status }}</span></td>
                <td class="td-actions">
                  <div class="row-menu" data-row-menu>
                    <button
                      type="button"
                      class="action-dots-btn"
                      aria-haspopup="true"
                      aria-expanded="false"
                      title="More actions"
                      aria-label="More actions for {{ page.title || 'page' }}"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="5" r="1.75" />
                        <circle cx="12" cy="12" r="1.75" />
                        <circle cx="12" cy="19" r="1.75" />
                      </svg>
                    </button>
                    <div class="row-menu-dropdown" role="menu">
                      @if(page.status === 'published')
                        <a
                          href="/{{ page.slug }}"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="row-menu-item"
                          role="menuitem"
                        >
                          <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                          </svg>
                          <span>View page</span>
                        </a>
                      @end
                      @form({
                        action: `/admin/pages/${page.id}/delete`,
                        method: 'POST',
                        'data-confirm': `Are you sure you want to permanently delete "${page.title || page.slug}"?`,
                        'data-confirm-title': 'Delete page',
                        'data-confirm-btn': 'Delete',
                        'data-confirm-variant': 'danger',
                      })
                        <button type="submit" class="row-menu-item danger" role="menuitem">
                          <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M3 6h18" />
                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                            <line x1="10" x2="10" y1="11" y2="17" />
                            <line x1="14" x2="14" y1="11" y2="17" />
                          </svg>
                          <span>Delete</span>
                        </button>
                      @end
                    </div>
                  </div>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      <div class="empty-state">
        <p>No content pages created yet.</p>
        <a href="/admin/pages/new">Create page</a>
      </div>
    @end
  </section>
@end
