@layouts.admin({ title: page ? 'Edit page' : 'New page', active: 'pages', adminName: admin.fullName })
  <a class="back-link" href="/admin/pages">← Back to pages</a>
  <div class="eyebrow">WORDS THAT MATTER</div>
  <div class="page-head">
    <div>
      <h1>{{ page ? en?.title : 'Create a page' }}</h1>
      <p>Manage the title, intro label and formatted content for each language.</p>
    </div>
    @if(page)
      <span class="status {{ page.status }}">{{ page.status }}</span>
    @end
  </div>

  @form({ action: page ? `/admin/pages/${page.id}/save` : '/admin/pages', method: 'POST', class: 'editor-grid' })
    <div class="editor-main">
      <section class="panel form-panel">
        <span class="eyebrow">ENGLISH CONTENT</span>
        <h2>Page details</h2>
        <div class="form-grid">
          <label>Page title<input name="titleEn" value="{{ en?.title || '' }}" required maxlength="200"></label>
          <label>Intro label <small>(above the title)</small><input name="eyebrowEn" value="{{ en?.eyebrow || '' }}" maxlength="120" placeholder="LEGAL &amp; POLICIES"></label>
          <label>URL slug<input name="slug" value="{{ page?.slug || '' }}" required pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="about-us"></label>
          <div class="rich-field">
            <label for="page-body-en">Body <small>Use headings and paragraphs for each section.</small></label>
            <input type="hidden" name="bodyFormatEn" value="{{ en?.body_format || 'plain_text' }}" data-rich-format>
            <textarea id="page-body-en" name="bodyEn" rows="13" required maxlength="50000" data-rich-body data-format="{{ en?.body_format || 'plain_text' }}">{{ en?.body || '' }}</textarea>
            <div class="rich-editor" data-rich-editor aria-label="English page body editor"></div>
          </div>
          <label>SEO title<input name="seoTitleEn" value="{{ en?.seo_title || '' }}"></label>
          <label>SEO description<textarea name="seoDescriptionEn" rows="2">{{ en?.seo_description || '' }}</textarea></label>
        </div>
      </section>
      <section class="panel form-panel">
        <span class="eyebrow">ARABIC CONTENT</span>
        <h2>Optional translation</h2>
        <div class="form-grid">
          <label>Arabic title<input name="titleAr" dir="rtl" lang="ar" value="{{ ar?.title || '' }}"></label>
          <label>Arabic intro label<input name="eyebrowAr" dir="rtl" lang="ar" value="{{ ar?.eyebrow || '' }}" maxlength="120"></label>
          <div class="rich-field" dir="rtl" lang="ar">
            <label for="page-body-ar">Arabic body</label>
            <input type="hidden" name="bodyFormatAr" value="{{ ar?.body_format || 'plain_text' }}" data-rich-format>
            <textarea id="page-body-ar" name="bodyAr" rows="8" maxlength="50000" data-rich-body data-format="{{ ar?.body_format || 'plain_text' }}">{{ ar?.body || '' }}</textarea>
            <div class="rich-editor" data-rich-editor aria-label="Arabic page body editor"></div>
          </div>
        </div>
      </section>
    </div>
    <aside class="editor-aside">
      <section class="panel form-panel actions-panel">
        <span class="eyebrow">PAGE STATUS</span>
        <p class="panel-help">Save your changes, review the copy, then publish. The public page date uses the page's last update timestamp.</p>
        <button class="button primary wide" type="submit">Save page <span>→</span></button>
      </section>
    </aside>
  @end

  @if(page)
    <div class="danger-row">
      @if(page.status !== 'published')
        @form({ action: `/admin/pages/${page.id}/publish`, method: 'POST' })
          <button class="button secondary" type="submit">Publish page</button>
        @end
      @else
        @form({ action: `/admin/pages/${page.id}/archive`, method: 'POST' })
          <button class="button secondary" type="submit">Archive page</button>
        @end
      @end
      @form({ action: `/admin/pages/${page.id}/delete`, method: 'POST', 'onsubmit': "return confirm('Permanently delete page?')" })
        <button class="text-button danger" type="submit">Delete permanently</button>
      @end
    </div>
  @end
@end
