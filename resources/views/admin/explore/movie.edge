@let(form = flashMessages.get('exploreForm') || {})
@layouts.admin({ title: movie ? 'Edit movie' : 'Add movie', active: 'movies', adminName: admin.fullName })
  <a class="back-link" href="/admin/movies">← Back to movies</a>

  <div class="page-head">
    <div>
      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <h1>{{ movie ? (form.title_en ?? movie.title_en) : 'Add movie' }}</h1>
        @if(movie)
          <span class="status {{ movie.status }}">{{ movie.status }}</span>
        @end
      </div>
    </div>
  </div>

  @form({ action: movie ? `/admin/movies/${movie.id}/save` : '/admin/movies', method: 'POST', enctype: 'multipart/form-data', class: 'editor-grid' })
    <div class="editor-main">
      <section class="panel form-panel">
        <h2>Details &amp; synopsis</h2>

        <div class="form-grid two" style="margin-top: 16px;">
          <label>
            English title
            <input
              name="title_en"
              value="{{ form.title_en ?? movie?.title_en ?? '' }}"
              maxlength="200"
              required
              placeholder="Dune: Part Two"
            />
          </label>

          <label>
            Arabic title
            <input
              name="title_ar"
              value="{{ form.title_ar ?? movie?.title_ar ?? '' }}"
              maxlength="200"
              lang="ar"
              dir="rtl"
              placeholder="كثيب: الجزء الثاني"
            />
          </label>

          <label class="full">
            English synopsis
            <textarea
              name="synopsis_en"
              rows="4"
              maxlength="10000"
              placeholder="Story description..."
            >{{ form.synopsis_en ?? movie?.synopsis_en ?? '' }}</textarea>
          </label>

          <label class="full">
            Arabic synopsis
            <textarea
              name="synopsis_ar"
              rows="4"
              maxlength="10000"
              lang="ar"
              dir="rtl"
            >{{ form.synopsis_ar ?? movie?.synopsis_ar ?? '' }}</textarea>
          </label>

          <label>
            Duration (minutes)
            <input
              name="duration_minutes"
              type="number"
              min="1"
              max="600"
              value="{{ form.duration_minutes ?? movie?.duration_minutes ?? '' }}"
              placeholder="120"
            />
          </label>

          <label>
            Age rating
            <input
              name="age_rating"
              value="{{ form.age_rating ?? movie?.age_rating ?? '' }}"
              maxlength="30"
              placeholder="PG-13 / 18+"
            />
          </label>

          <label class="full">
            Status
            <select name="status">
              @each(status in ['draft', 'published', 'archived'])
                <option
                  value="{{ status }}"
                  @if((form.status ?? movie?.status ?? 'draft') === status)
                    selected
                  @end
                >
                  {{ status }}
                </option>
              @end
            </select>
          </label>
        </div>
      </section>
    </div>

    <aside class="editor-aside">
      <!-- Poster Upload Panel -->
      <section class="panel form-panel">
        <h2>Movie poster</h2>

        <div style="margin-top: 12px;">
          @if(posterUrl)
            <img
              class="cover-preview"
              src="{{ posterUrl }}"
              alt="{{ movie.title_en }} poster"
              style="aspect-ratio: 2/3; object-fit: cover; max-height: 280px;"
            />
          @else
            <div class="cover-placeholder" style="aspect-ratio: 2/3; height: 180px;">No poster uploaded</div>
          @end

          <div class="image-upload" style="margin-top: 12px;">
            <span style="display: block; font-weight: 600; margin-bottom: 6px;">
              {{ posterUrl ? 'Replace poster' : 'Upload poster' }}
            </span>
            <input
              type="file"
              name="poster"
              accept="image/jpeg,image/png,image/webp"
              aria-label="Movie poster image"
              data-image-upload
            />
          </div>

          @if(posterUrl)
            <label class="checkbox-line" style="margin-top: 10px;">
              <input type="checkbox" name="removePoster" /> Remove poster
            </label>
          @end
        </div>
      </section>

      <!-- Publishing Panel -->
      <section class="panel form-panel actions-panel">
        <h2>Publishing</h2>
        <div class="save-controls-stack" style="margin-top: 16px;">
          <button class="button primary wide" type="submit">
            Save {{ movie ? 'changes' : 'movie' }}
          </button>
        </div>
      </section>
    </aside>
  @end

  @if(movie)
    <section class="panel danger-zone-panel" style="max-width: 600px;">
      <h2>Danger zone</h2>
      <div style="margin-top: 14px;">
        @form({ action: `/admin/movies/${movie.id}/delete`, method: 'POST', 'data-confirm': 'Permanently delete this movie? Ensure no showtimes exist for it.' })
          <button class="button danger" type="submit">Delete movie</button>
        @end
      </div>
    </section>
  @end
@end
