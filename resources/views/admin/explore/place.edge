@let(form = flashMessages.get('exploreForm') || {})
@layouts.admin({ title: 'Explore details', active: 'places', adminName: admin.fullName })
  <a class="back-link" href="/admin/places/{{ place.id }}/edit">← Back to place editor</a>

  <div class="page-head">
    <div>
      <h1>Explore details: {{ place.slug }}</h1>
    </div>
  </div>

  @form({ action: `/admin/places/${place.id}/explore`, method: 'POST', id: 'explore-form' })
    <!-- Section 1: Visitor Information -->
    <section class="panel form-panel">
      <h2>Visitor information</h2>

      <div class="form-grid two" style="margin-top: 16px;">
        <label>
          Venue phone
          <input
            name="phone_e164"
            value="{{ form.phone_e164 ?? place.phone_e164 ?? '' }}"
            placeholder="+96590987788"
            maxlength="16"
          />
        </label>

        @if(place.type === 'hotel_resort')
          <label>
            Check-in time
            <input
              name="check_in_time"
              type="time"
              value="{{ (form.check_in_time ?? place.check_in_time ?? '').slice(0, 5) }}"
            />
          </label>

          <label>
            Check-out time
            <input
              name="check_out_time"
              type="time"
              value="{{ (form.check_out_time ?? place.check_out_time ?? '').slice(0, 5) }}"
            />
          </label>
        @end

        @if(place.type === 'theater')
          <label>
            Number of screens
            <input
              name="screen_count"
              type="number"
              min="1"
              max="1000"
              value="{{ form.screen_count ?? place.screen_count ?? '' }}"
            />
          </label>
          <div class="full" style="margin-top: 4px;">
            <a class="button secondary" href="/admin/showtimes?place_id={{ place.id }}">
              Manage showtimes
            </a>
          </div>
        @end
      </div>
    </section>

    <!-- Section 2: Features, Highlights & Amenities -->
    <section class="panel form-panel">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <h2>Highlights &amp; amenities</h2>
        <a class="text-button" href="/admin/place-features?type={{ place.type }}">
          Manage feature definitions
        </a>
      </div>

      <div class="form-grid two" style="margin-top: 16px;">
        @each(feature in features)
          <label class="checkbox-line" style="border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 8px 12px; background: var(--surface-subtle);">
            <input
              type="checkbox"
              name="feature_ids[]"
              value="{{ feature.id }}"
              @if(selectedFeatures.includes(feature.id))
                checked
              @end
            />
            <span>
              <strong>{{ feature.name_en }}</strong>
              <small style="display: block; color: var(--muted);">
                {{ feature.kind }} · {{ feature.code }}{{ feature.active ? '' : ' (hidden)' }}
              </small>
            </span>
          </label>
        @else
          <p class="panel-help">No feature definitions found for this place type. <a href="/admin/place-features?type={{ place.type }}">Add feature definitions</a>.</p>
        @end
      </div>
    </section>

    <!-- Section 3: Weekly Opening Hours -->
    <section class="panel form-panel">
      <h2>Weekly opening hours</h2>

      <div class="weekly-hours-container" id="weekly-hours-container">
        @each(day in days)
          <div class="day-hours-card {{ day.state === 'open' ? 'open-day' : (day.state === 'closed' ? 'closed-day' : 'unknown-day') }}" data-weekday="{{ day.weekday }}" data-state="{{ day.state }}">
            <div class="day-hours-header">
              <span class="day-title">
                <span>{{ day.name }}</span>
                <span class="status {{ day.state === 'open' ? 'published' : (day.state === 'closed' ? 'archived' : 'draft') }}" style="font-size: 11px; padding: 2px 8px;" data-badge>
                  {{ day.state }}
                </span>
              </span>

              <div class="day-state-radios" role="group" aria-label="Schedule status for {{ day.name }}">
                <button
                  type="button"
                  class="day-state-btn {{ day.state === 'unknown' ? 'active' : '' }}"
                  data-set-state="unknown"
                >
                  Unknown
                </button>
                <button
                  type="button"
                  class="day-state-btn {{ day.state === 'closed' ? 'active' : '' }}"
                  data-set-state="closed"
                >
                  Closed
                </button>
                <button
                  type="button"
                  class="day-state-btn {{ day.state === 'open' ? 'active' : '' }}"
                  data-set-state="open"
                >
                  Open
                </button>
              </div>
            </div>

            <!-- Unknown state content -->
            <div class="day-unknown-body" style="display: {{ day.state === 'unknown' ? 'block' : 'none' }}; color: var(--muted); font-size: 13px;">
              No schedule specified. Marked as unknown on public guide.
            </div>

            <!-- Closed state content -->
            <div class="day-closed-body" style="display: {{ day.state === 'closed' ? 'block' : 'none' }};">
              <span style="font-size: 13px; font-weight: 600; color: var(--danger-text);">Explicitly closed all day</span>
              <input type="hidden" class="closed-input-weekday" value="{{ day.weekday }}" disabled />
              <input type="hidden" class="closed-input-order" value="0" disabled />
              <input type="hidden" class="closed-input-closed" value="on" disabled />
            </div>

            <!-- Open state content with intervals -->
            <div class="day-open-body" style="display: {{ day.state === 'open' ? 'block' : 'none' }};">
              <div class="intervals-list" data-intervals-list>
                @if(day.intervals && day.intervals.length)
                  @each((interval, idx) in day.intervals)
                    <div class="interval-row" data-interval-row>
                      <input type="hidden" class="inp-weekday" value="{{ day.weekday }}" />
                      <input type="hidden" class="inp-order" value="{{ interval.interval_index }}" />
                      <div class="interval-time-group">
                        <label style="font-size: 12px; gap: 2px;">
                          Opens at
                          <input type="time" class="inp-opens" value="{{ interval.opens_at }}" required />
                        </label>
                        <span style="align-self: center; margin-top: 18px; color: var(--muted); font-weight: bold;">–</span>
                        <label style="font-size: 12px; gap: 2px;">
                          Closes at
                          <input type="time" class="inp-closes" value="{{ interval.closes_at }}" required />
                        </label>
                      </div>
                      <label class="checkbox-line" style="margin-top: 16px; font-size: 13px;">
                        <input type="checkbox" class="inp-nextday" @if(interval.closes_next_day) checked @end />
                        Closes next day (overnight)
                      </label>
                      <button type="button" class="text-button danger remove-interval-btn" style="margin-top: 16px; margin-left: auto;">
                        Remove interval
                      </button>
                    </div>
                  @end
                @else
                  <div class="interval-row" data-interval-row>
                    <input type="hidden" class="inp-weekday" value="{{ day.weekday }}" />
                    <input type="hidden" class="inp-order" value="0" />
                    <div class="interval-time-group">
                      <label style="font-size: 12px; gap: 2px;">
                        Opens at
                        <input type="time" class="inp-opens" value="09:00" required />
                      </label>
                      <span style="align-self: center; margin-top: 18px; color: var(--muted); font-weight: bold;">–</span>
                      <label style="font-size: 12px; gap: 2px;">
                        Closes at
                        <input type="time" class="inp-closes" value="22:00" required />
                      </label>
                    </div>
                    <label class="checkbox-line" style="margin-top: 16px; font-size: 13px;">
                      <input type="checkbox" class="inp-nextday" />
                      Closes next day (overnight)
                    </label>
                    <button type="button" class="text-button danger remove-interval-btn" style="margin-top: 16px; margin-left: auto;">
                      Remove interval
                    </button>
                  </div>
                @end
              </div>
              <button type="button" class="text-button add-interval-btn" style="margin-top: 10px;">
                + Add split interval for {{ day.name }}
              </button>
            </div>
          </div>
        @end
      </div>
    </section>

    <!-- Save Button -->
    <div style="display: flex; gap: 16px; align-items: center; margin-top: 24px;">
      <button class="button primary" type="submit" id="save-explore-btn">
        Save Explore details <span class="btn-arrow">→</span>
      </button>
      <a class="button secondary" href="/admin/places/{{ place.id }}/edit">Back to place</a>
    </div>
  @end

  <script>
    (function () {
      const container = document.getElementById('weekly-hours-container');
      const form = document.getElementById('explore-form');
      if (!container || !form) return;

      function updateCardState(card, newState) {
        card.setAttribute('data-state', newState);
        card.className = 'day-hours-card ' + (newState === 'open' ? 'open-day' : (newState === 'closed' ? 'closed-day' : 'unknown-day'));

        // Badge update
        const badge = card.querySelector('[data-badge]');
        if (badge) {
          badge.textContent = newState;
          badge.className = 'status ' + (newState === 'open' ? 'published' : (newState === 'closed' ? 'archived' : 'draft'));
        }

        // Radios active class
        card.querySelectorAll('[data-set-state]').forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-set-state') === newState);
        });

        // Bodies visibility
        card.querySelector('.day-unknown-body').style.display = newState === 'unknown' ? 'block' : 'none';
        card.querySelector('.day-closed-body').style.display = newState === 'closed' ? 'block' : 'none';
        card.querySelector('.day-open-body').style.display = newState === 'open' ? 'block' : 'none';

        if (newState === 'open') {
          const list = card.querySelector('[data-intervals-list]');
          if (!list.querySelector('[data-interval-row]')) {
            addIntervalRow(card);
          }
        }
      }

      function addIntervalRow(card, opens = '09:00', closes = '22:00', nextDay = false) {
        const list = card.querySelector('[data-intervals-list]');
        const weekday = card.getAttribute('data-weekday');
        const rows = list.querySelectorAll('[data-interval-row]');
        const order = rows.length;

        const row = document.createElement('div');
        row.className = 'interval-row';
        row.setAttribute('data-interval-row', '');
        row.innerHTML = `
          <input type="hidden" class="inp-weekday" value="${weekday}" />
          <input type="hidden" class="inp-order" value="${order}" />
          <div class="interval-time-group">
            <label style="font-size: 12px; gap: 2px;">
              Opens at
              <input type="time" class="inp-opens" value="${opens}" required />
            </label>
            <span style="align-self: center; margin-top: 18px; color: var(--muted); font-weight: bold;">–</span>
            <label style="font-size: 12px; gap: 2px;">
              Closes at
              <input type="time" class="inp-closes" value="${closes}" required />
            </label>
          </div>
          <label class="checkbox-line" style="margin-top: 16px; font-size: 13px;">
            <input type="checkbox" class="inp-nextday" ${nextDay ? 'checked' : ''} />
            Closes next day (overnight)
          </label>
          <button type="button" class="text-button danger remove-interval-btn" style="margin-top: 16px; margin-left: auto;">
            Remove interval
          </button>
        `;
        list.appendChild(row);
      }

      container.addEventListener('click', function (e) {
        const stateBtn = e.target.closest('[data-set-state]');
        if (stateBtn) {
          const card = stateBtn.closest('.day-hours-card');
          updateCardState(card, stateBtn.getAttribute('data-set-state'));
          return;
        }

        const addBtn = e.target.closest('.add-interval-btn');
        if (addBtn) {
          const card = addBtn.closest('.day-hours-card');
          addIntervalRow(card, '17:00', '23:00', false);
          return;
        }

        const removeBtn = e.target.closest('.remove-interval-btn');
        if (removeBtn) {
          const card = removeBtn.closest('.day-hours-card');
          const row = removeBtn.closest('[data-interval-row]');
          row.remove();
          const remaining = card.querySelectorAll('[data-interval-row]');
          if (remaining.length === 0) {
            updateCardState(card, 'unknown');
          } else {
            remaining.forEach((r, idx) => {
              r.querySelector('.inp-order').value = idx;
            });
          }
          return;
        }
      });

      // Synchronize input names before submit
      form.addEventListener('submit', function () {
        let globalIndex = 0;
        container.querySelectorAll('.day-hours-card').forEach(card => {
          const state = card.getAttribute('data-state');
          const weekday = card.getAttribute('data-weekday');

          if (state === 'closed') {
            const wkInput = card.querySelector('.closed-input-weekday');
            const ordInput = card.querySelector('.closed-input-order');
            const clInput = card.querySelector('.closed-input-closed');
            wkInput.name = `place_hours[${globalIndex}][weekday]`;
            wkInput.disabled = false;
            ordInput.name = `place_hours[${globalIndex}][interval_index]`;
            ordInput.disabled = false;
            clInput.name = `place_hours[${globalIndex}][closed]`;
            clInput.disabled = false;
            globalIndex++;
          } else if (state === 'open') {
            card.querySelectorAll('[data-interval-row]').forEach((row, intervalIdx) => {
              const wkInput = row.querySelector('.inp-weekday');
              const ordInput = row.querySelector('.inp-order');
              const opInput = row.querySelector('.inp-opens');
              const clInput = row.querySelector('.inp-closes');
              const ndInput = row.querySelector('.inp-nextday');

              wkInput.name = `place_hours[${globalIndex}][weekday]`;
              ordInput.name = `place_hours[${globalIndex}][interval_index]`;
              ordInput.value = intervalIdx;
              opInput.name = `place_hours[${globalIndex}][opens_at]`;
              clInput.name = `place_hours[${globalIndex}][closes_at]`;
              ndInput.name = `place_hours[${globalIndex}][closes_next_day]`;
              globalIndex++;
            });
          }
        });
      });
    })();
  </script>
@end
