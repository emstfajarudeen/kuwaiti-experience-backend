@layouts.admin({ title: 'Movies', active: 'movies', adminName: admin.fullName })
  <div class="page-head">
    <div>
      <h1>Movies</h1>
    </div>
    <div class="page-head-actions">
      <a class="button primary" href="/admin/movies/new">+ Add movie</a>
      <a class="button secondary" href="/admin/showtimes">Showtimes</a>
    </div>
  </div>

  <section class="panel table-panel">
    <div class="panel-heading">
      <h2>Movies ({{ result.meta.total }})</h2>
      <a
        class="button secondary"
        href="/admin/movies/new"
        style="min-height: 36px; padding: 6px 14px;"
      >
        + Add movie
      </a>
    </div>
    @if(result && result.data && result.data.length)
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col" class="th-edit" aria-label="Edit"></th>
              <th scope="col">Title</th>
              <th scope="col">Status</th>
              <th scope="col">Duration</th>
              <th scope="col" class="th-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            @each(movie in result.data)
              <tr>
                <td class="td-edit">
                  <a
                    href="/admin/movies/{{ movie.id }}/edit"
                    class="action-pencil-btn"
                    title="Edit {{ movie.title_en }}"
                    aria-label="Edit {{ movie.title_en }}"
                  >
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                      <path d="m15 5 4 4" />
                    </svg>
                  </a>
                </td>
                <td>
                  <div class="place-title-wrap">
                    <strong>{{ movie.title_en }}</strong>
                    @if(movie.title_ar)
                      <small dir="rtl">{{ movie.title_ar }}</small>
                    @end
                  </div>
                </td>
                <td><span class="status {{ movie.status }}">{{ movie.status }}</span></td>
                <td>
                  {{
                    movie.duration_minutes
                      ? `${movie.duration_minutes} min`
                      : '—'
                  }}
                </td>
                <td class="td-actions">
                  <div class="row-menu" data-row-menu>
                    <button
                      type="button"
                      class="action-dots-btn"
                      aria-haspopup="true"
                      aria-expanded="false"
                      title="More actions"
                      aria-label="More actions for {{ movie.title_en }}"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="5" r="1.75" />
                        <circle cx="12" cy="12" r="1.75" />
                        <circle cx="12" cy="19" r="1.75" />
                      </svg>
                    </button>
                    <div class="row-menu-dropdown" role="menu">
                      @form({
                        action: `/admin/movies/${movie.id}/delete`,
                        method: 'POST',
                        'data-confirm': `Permanently delete movie "${movie.title_en}"? Ensure no showtimes exist for it.`,
                        'data-confirm-title': 'Delete movie',
                        'data-confirm-btn': 'Delete',
                        'data-confirm-variant': 'danger',
                      })
                        <button type="submit" class="row-menu-item danger" role="menuitem">
                          <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M3 6h18" />
                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                            <line x1="10" x2="10" y1="11" y2="17" />
                            <line x1="14" x2="14" y1="11" y2="17" />
                          </svg>
                          <span>Delete</span>
                        </button>
                      @end
                    </div>
                  </div>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
      @if(result.meta.lastPage > 1)
        <div class="pagination-bar">
          <span class="pagination-info">
            Page
            {{ result.meta.currentPage }}
            of
            {{ result.meta.lastPage }}
          </span>
          <div class="pagination-nav">
            @if(result.meta.currentPage > 1)
              <a
                class="button secondary table-action"
                href="/admin/movies?page={{ result.meta.currentPage - 1 }}"
              >
                Previous
              </a>
            @end
            @if(result.meta.currentPage < result.meta.lastPage)
              <a
                class="button secondary table-action"
                href="/admin/movies?page={{ result.meta.currentPage + 1 }}"
              >
                Next
              </a>
            @end
          </div>
        </div>
      @end
    @else
      <div class="empty-state">
        <p>No movies found.</p>
        <a href="/admin/movies/new">Create movie</a>
      </div>
    @end
  </section>
@end
