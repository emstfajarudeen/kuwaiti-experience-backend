
@let(form = flashMessages.get('exploreForm') || {})

@layouts.admin({ title: 'Place features', active: 'place-features', adminName: admin.fullName })

  <div class="page-head"><div><h1>Place features</h1><p>Manage the highlights, amenities and capability chips used across Explore.</p></div></div>
  
@form({ action: editing ? `/admin/place-features/${editing.id}/save` : '/admin/place-features', method: 'POST' })

    <section class="panel form-panel"><h2>{{ editing ? 'Edit feature' : 'Add feature' }}</h2><div class="form-grid two">
      <label>Place type<select name="type" required>
@each(type in types)
<option value="{{ type.code }}" 
@if((form.type ?? editing?.type ?? selectedType) === type.code)
 selected 
@end
>{{ type.name_en }}</option>
@end
</select></label>
      <label>Kind<select name="kind">
@each(kind in ['highlight', 'amenity', 'capability'])
<option value="{{ kind }}" 
@if((form.kind ?? editing?.kind) === kind)
 selected 
@end
>{{ kind }}</option>
@end
</select></label>
      <label>Code<input name="code" value="{{ form.code ?? editing?.code ?? '' }}" maxlength="80" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="sea-view" required></label>
      <label>English label<input name="name_en" value="{{ form.name_en ?? editing?.name_en ?? '' }}" maxlength="120" required></label>
      <label>Arabic label<input name="name_ar" value="{{ form.name_ar ?? editing?.name_ar ?? '' }}" dir="rtl" lang="ar" maxlength="120"></label>
      <label>Display order<input name="sort_order" type="number" min="0" max="999" value="{{ form.sort_order ?? editing?.sort_order ?? 0 }}" required></label>
    </div>
    <div class="feature-visibility">
      <label class="checkbox-line"><input name="active" type="checkbox" 
@if(editing ? editing.active : true)
 checked 
@end
> Visible to visitors</label>
    </div>
    <button class="button primary" type="submit">Save feature</button> 
@if(editing)
<a class="button secondary" href="/admin/place-features">Add another</a>
@end
</section>
  
@end

  <section class="panel form-panel"><h2>Feature library</h2><p class="panel-help">Assign features from each place's Explore editor. Inactive features are hidden publicly. Assigned features must be unassigned before deletion.</p>
    <div class="table-wrap"><table><thead><tr><th>Feature</th><th>Type</th><th>Kind</th><th>Visible</th><th>Actions</th></tr></thead><tbody>
      
@each(feature in features)

        <tr><td>{{ feature.name_en }}<small>{{ feature.code }}</small></td><td>{{ feature.type }}</td><td>{{ feature.kind }}</td><td>{{ feature.active ? 'Yes' : 'No' }}</td><td><a href="/admin/place-features/{{ feature.id }}/edit">Edit</a> 
@form({ action: `/admin/place-features/${feature.id}/delete`, method: 'POST' })
<button class="text-button danger" type="submit">Delete</button>
@end
</td></tr>
      
@else

        <tr><td colspan="5">No feature definitions yet.</td></tr>
      
@end

    </tbody></table></div>
  </section>

@end

