@let(form = flashMessages.get('exploreForm') || {})
@layouts.admin({ title: 'Place features', active: 'place-features', adminName: admin.fullName })
  <div class="page-head">
    <div>
      <h1>Place features</h1>
    </div>
  </div>

  <div class="content-grid">
    <!-- Feature Editor Form -->
    <section class="panel form-panel">
      <div class="panel-heading" style="padding: 0 0 16px; border-bottom: 1px solid var(--line-subtle); margin-bottom: 16px;">
        <h2>{{ editing ? 'Edit feature' : 'Add feature' }}</h2>
        @if(editing)
          <a class="text-button" href="/admin/place-features">+ Add feature</a>
        @end
      </div>

      @form({ action: editing ? `/admin/place-features/${editing.id}/save` : '/admin/place-features', method: 'POST' })
        <div class="form-grid">
          <label>
            Place type
            <select name="type" required>
              @each(type in types)
                <option
                  value="{{ type.code }}"
                  @if((form.type ?? editing?.type ?? selectedType) === type.code)
                    selected
                  @end
                >
                  {{ type.name_en }}
                </option>
              @end
            </select>
          </label>

          <label>
            Kind
            <select name="kind">
              @each(kind in ['highlight', 'amenity', 'capability'])
                <option
                  value="{{ kind }}"
                  @if((form.kind ?? editing?.kind) === kind)
                    selected
                  @end
                >
                  {{ kind }}
                </option>
              @end
            </select>
          </label>

          <label>
            Code
            <input
              name="code"
              value="{{ form.code ?? editing?.code ?? '' }}"
              maxlength="80"
              pattern="[a-z0-9]+(-[a-z0-9]+)*"
              placeholder="sea-view"
              required
            />
          </label>

          <label>
            English label
            <input
              name="name_en"
              value="{{ form.name_en ?? editing?.name_en ?? '' }}"
              maxlength="120"
              required
              placeholder="Sea View"
            />
          </label>

          <label>
            Arabic label
            <input
              name="name_ar"
              value="{{ form.name_ar ?? editing?.name_ar ?? '' }}"
              dir="rtl"
              lang="ar"
              maxlength="120"
              placeholder="إطلالة بحرية"
            />
          </label>

          <label>
            Display order
            <input
              name="sort_order"
              type="number"
              min="0"
              max="999"
              value="{{ form.sort_order ?? editing?.sort_order ?? 0 }}"
              required
            />
          </label>

          <label class="checkbox-line" style="margin-top: 6px;">
            <input
              name="active"
              type="checkbox"
              @if(form.active !== undefined ? form.active === 'on' : (editing ? editing.active : true))
                checked
              @end
            />
            Visible to visitors
          </label>

          <div style="margin-top: 12px; display: flex; gap: 12px; align-items: center;">
            <button class="button primary" type="submit">
              {{ editing ? 'Update feature' : 'Save feature' }}
            </button>
            @if(editing)
              <a class="button secondary" href="/admin/place-features">Cancel</a>
            @end
          </div>
        </div>
      @end
    </section>

    <!-- Features Library Table -->
    <section class="panel table-panel">
      <div class="panel-heading">
        <h2>Features ({{ features.length }})</h2>
      </div>

      @if(features && features.length)
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col" class="th-edit" aria-label="Edit"></th>
                <th scope="col">Feature</th>
                <th scope="col">Type</th>
                <th scope="col">Kind</th>
                <th scope="col">Status</th>
                <th scope="col" class="th-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
              @each(feature in features)
                <tr>
                  <td class="td-edit">
                    <a
                      href="/admin/place-features/{{ feature.id }}/edit"
                      class="action-pencil-btn"
                      title="Edit {{ feature.name_en }}"
                      aria-label="Edit {{ feature.name_en }}"
                    >
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                        <path d="m15 5 4 4"/>
                      </svg>
                    </a>
                  </td>
                  <td>
                    <div class="place-title-wrap">
                      <strong>{{ feature.name_en }}</strong>
                      <small>{{ feature.code }}</small>
                    </div>
                  </td>
                  <td>
                    <span class="type-chip" style="font-size: 11px; padding: 2px 6px;">{{ feature.type }}</span>
                  </td>
                  <td>
                    <span style="font-size: 12px; color: var(--muted); text-transform: capitalize;">{{ feature.kind }}</span>
                  </td>
                  <td>
                    <span class="status {{ feature.active ? 'published' : 'archived' }}">
                      {{ feature.active ? 'Active' : 'Hidden' }}
                    </span>
                  </td>
                  <td class="td-actions">
                    <div class="row-menu" data-row-menu>
                      <button
                        type="button"
                        class="action-dots-btn"
                        aria-haspopup="true"
                        aria-expanded="false"
                        title="More actions"
                        aria-label="More actions for {{ feature.name_en }}"
                      >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                          <circle cx="12" cy="5" r="1.75"/>
                          <circle cx="12" cy="12" r="1.75"/>
                          <circle cx="12" cy="19" r="1.75"/>
                        </svg>
                      </button>
                      <div class="row-menu-dropdown" role="menu">
                        @form({
                          action: `/admin/place-features/${feature.id}/delete`,
                          method: 'POST',
                          'data-confirm': `Delete feature "${feature.name_en}"? Ensure it is not assigned to any venue.`,
                          'data-confirm-title': 'Delete feature',
                          'data-confirm-btn': 'Delete',
                          'data-confirm-variant': 'danger'
                        })
                          <button type="submit" class="row-menu-item danger" role="menuitem">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M3 6h18"/>
                              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                              <line x1="10" x2="10" y1="11" y2="17"/>
                              <line x1="14" x2="14" y1="11" y2="17"/>
                            </svg>
                            <span>Delete</span>
                          </button>
                        @end
                      </div>
                    </div>
                  </td>
                </tr>
              @end
            </tbody>
          </table>
        </div>
      @else
        <div class="empty-state">
          <span class="empty-state-icon">✦</span>
          <p>No feature definitions created yet.</p>
        </div>
      @end
    </section>
  </div>
@end
