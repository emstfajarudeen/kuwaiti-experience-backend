@let(form = flashMessages.get('exploreForm') || {})
@layouts.admin({ title: 'Theater showtimes', active: 'showtimes', adminName: admin.fullName })
  <div class="page-head">
    <div>
      <h1>Theater showtimes</h1>
    </div>
    <div class="page-head-actions">
      <a class="button secondary" href="/admin/movies">Movies</a>
    </div>
  </div>

  <div class="content-grid">
    <!-- Showtime Form -->
    <section class="panel form-panel">
      <div class="panel-heading" style="padding: 0 0 16px; border-bottom: 1px solid var(--line-subtle); margin-bottom: 16px;">
        <h2>{{ editing ? 'Edit showtime' : 'Schedule showtime' }}</h2>
        @if(editing)
          <a class="text-button" href="/admin/showtimes">+ New showtime</a>
        @end
      </div>

      @form({ action: editing ? `/admin/showtimes/${editing.id}/save` : '/admin/showtimes', method: 'POST' })
        <div class="form-grid">
          <label>
            Theater venue
            <select name="place_id" required>
              <option value="">Choose a theater</option>
              @each(place in theaters)
                <option
                  value="{{ place.id }}"
                  @if(Number(form.place_id ?? editing?.place_id) === place.id)
                    selected
                  @end
                >
                  {{ place.slug }} ({{ place.status }})
                </option>
              @end
            </select>
          </label>

          <label>
            Movie
            <select name="movie_id" required>
              <option value="">Choose a movie</option>
              @each(movie in movies)
                <option
                  value="{{ movie.id }}"
                  @if(Number(form.movie_id ?? editing?.movie_id) === movie.id)
                    selected
                  @end
                >
                  {{ movie.title_en }} ({{ movie.status }})
                </option>
              @end
            </select>
          </label>

          <label>
            Starts at (Kuwait time)
            <input
              name="starts_at"
              type="datetime-local"
              value="{{ form.starts_at ?? startsLocal }}"
              required
            />
          </label>

          <label>
            Presentation format
            <input
              name="format"
              value="{{ form.format ?? editing?.format ?? '' }}"
              maxlength="80"
              placeholder="IMAX · Standard"
              required
            />
          </label>

          <label>
            Status
            <select name="status">
              @each(status in ['draft', 'published', 'cancelled'])
                <option
                  value="{{ status }}"
                  @if((form.status ?? editing?.status ?? 'draft') === status)
                    selected
                  @end
                >
                  {{ status }}
                </option>
              @end
            </select>
          </label>

          <div style="margin-top: 8px; display: flex; gap: 12px; align-items: center;">
            <button class="button primary" type="submit">
              {{ editing ? 'Update showtime' : 'Save showtime' }}
            </button>
            @if(editing)
              <a class="button secondary" href="/admin/showtimes">Cancel</a>
            @end
          </div>
        </div>
      @end
    </section>

    <!-- Sessions Table -->
    <section class="panel table-panel">
      <div class="panel-heading">
        <h2>Showtimes ({{ result.meta.total }})</h2>
      </div>

      @if(result && result.data && result.data.length)
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col" class="th-edit" aria-label="Edit"></th>
                <th scope="col">Movie</th>
                <th scope="col">Theater</th>
                <th scope="col">Starts (UTC)</th>
                <th scope="col">Format</th>
                <th scope="col">Status</th>
                <th scope="col" class="th-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
              @each(showtime in result.data)
                <tr>
                  <td class="td-edit">
                    <a
                      href="/admin/showtimes?id={{ showtime.id }}"
                      class="action-pencil-btn"
                      title="Edit showtime"
                      aria-label="Edit showtime"
                    >
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                        <path d="m15 5 4 4"/>
                      </svg>
                    </a>
                  </td>
                  <td>
                    <strong>
                      {{ result.included.movies.find((m) => m.id === showtime.movie_id)?.title_en || showtime.movie_id }}
                    </strong>
                  </td>
                  <td>
                    <code>{{ showtime.place_id }}</code>
                  </td>
                  <td>{{ showtime.starts_at }}</td>
                  <td>
                    <span class="type-pill">{{ showtime.format }}</span>
                  </td>
                  <td>
                    <span class="status {{ showtime.status === 'published' ? 'published' : (showtime.status === 'cancelled' ? 'archived' : 'draft') }}">
                      {{ showtime.status }}
                    </span>
                  </td>
                  <td class="td-actions">
                    <div class="row-menu" data-row-menu>
                      <button
                        type="button"
                        class="action-dots-btn"
                        aria-haspopup="true"
                        aria-expanded="false"
                        title="More actions"
                        aria-label="More actions for showtime"
                      >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                          <circle cx="12" cy="5" r="1.75"/>
                          <circle cx="12" cy="12" r="1.75"/>
                          <circle cx="12" cy="19" r="1.75"/>
                        </svg>
                      </button>
                      <div class="row-menu-dropdown" role="menu">
                        @form({
                          action: `/admin/showtimes/${showtime.id}/delete`,
                          method: 'POST',
                          'data-confirm': 'Are you sure you want to delete this showtime?',
                          'data-confirm-title': 'Delete showtime',
                          'data-confirm-btn': 'Delete',
                          'data-confirm-variant': 'danger'
                        })
                          <button type="submit" class="row-menu-item danger" role="menuitem">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M3 6h18"/>
                              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                              <line x1="10" x2="10" y1="11" y2="17"/>
                              <line x1="14" x2="14" y1="11" y2="17"/>
                            </svg>
                            <span>Delete</span>
                          </button>
                        @end
                      </div>
                    </div>
                  </td>
                </tr>
              @end
            </tbody>
          </table>
        </div>
      @else
        <div class="empty-state">
          <p>No showtimes scheduled.</p>
        </div>
      @end
    </section>
  </div>
@end
