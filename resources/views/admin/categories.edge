@layouts.admin({ title: 'Categories', active: 'categories', adminName: admin.fullName })
  <div class="page-head">
    <div>
      <h1>Categories</h1>
    </div>
    <div class="page-head-actions">
      <a class="button secondary" href="/admin/category-types">Category types</a>
    </div>
  </div>

  <div class="content-grid">
    <section class="panel form-panel">
      <h2>Add a category</h2>

      @form({ action: '/admin/categories', method: 'POST', class: 'form-grid' })
        <label>
          Place type
          <select name="type">
            @each(type in types)
              <option value="{{ type.code }}">{{ type.name_en }}</option>
            @end
          </select>
        </label>
        <label>English name<input name="nameEn" required maxlength="160" placeholder="Landmarks" /></label>
        <label>Arabic name<input name="nameAr" dir="rtl" lang="ar" maxlength="160" /></label>
        <label>Slug<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="landmarks" /></label>
        <label>Order<input name="sortOrder" type="number" value="0" /></label>
        <label class="checkbox-line"><input name="active" type="checkbox" checked /> Active</label>
        <button class="button primary" type="submit">Create category</button>
      @end
    </section>

    <section class="panel form-panel">
      <h2>Categories ({{ rows.length }})</h2>

      @if(rows.length)
        <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 16px;">
          @each(item in rows)
            <details class="panel" style="margin-bottom: 0; box-shadow: none; border: 1px solid var(--line);">
              <summary style="padding: 14px 18px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-weight: 600;">
                <span><strong>{{ item.name }}</strong> <small style="color: var(--muted);">{{ item.type.replace('_', ' ') }} / {{ item.slug }}</small></span>
                <span style="color: var(--gold-deep); font-weight: bold;">Edit ▾</span>
              </summary>
              <div style="padding: 18px; border-top: 1px solid var(--line-subtle); background: var(--surface-subtle);">
                @form({ action: `/admin/categories/${item.id}/save`, method: 'POST', class: 'form-grid two' })
                  <label>
                    Place type
                    <select name="type">
                      @each(type in types)
                        <option value="{{ type.code }}" @if(item.type === type.code) selected @end>{{ type.name_en }}</option>
                      @end
                    </select>
                  </label>
                  <label>English name<input name="nameEn" value="{{ item.name }}" required /></label>
                  <label>Arabic name<input name="nameAr" dir="rtl" value="{{ item.name_ar || '' }}" /></label>
                  <label>Slug<input name="slug" value="{{ item.slug }}" required /></label>
                  <label>Order<input name="sortOrder" type="number" value="{{ item.sort_order }}" /></label>
                  <div class="full" style="display: flex; gap: 16px;">
                    <label class="checkbox-line"><input name="active" type="checkbox" @if(item.active) checked @end /> Active</label>
                  </div>
                  <div class="full" style="display: flex; gap: 12px; align-items: center; margin-top: 8px;">
                    <button class="button secondary" type="submit">Save changes</button>
                  </div>
                @end
                <div style="margin-top: 14px; border-top: 1px solid var(--line); padding-top: 12px;">
                  @form({ action: `/admin/categories/${item.id}/delete`, method: 'POST', 'data-confirm': `Delete category "${item.name}"?` })
                    <button class="text-button danger" type="submit">Delete category</button>
                  @end
                </div>
              </div>
            </details>
          @end
        </div>
      @else
        <div class="empty-state">
          <p>No categories added yet.</p>
        </div>
      @end
    </section>
  </div>
@end
