@layouts.admin({ title: 'My account', active: 'account', adminName: admin.fullName })
  <div class="page-head">
    <div>
      <h1>My account</h1>
    </div>
  </div>

  <div style="max-width: 540px;">
    @form({
      action: '/admin/account/password',
      method: 'POST',
      class: 'panel form-panel',
    })
      <div
        class="panel-heading"
        style="padding: 0 0 16px; border-bottom: 1px solid var(--line-subtle); margin-bottom: 20px;"
      >
        <h2>Change password</h2>
      </div>

      <div class="form-grid" style="gap: 20px;">
        <label>
          
          
          Current password


          <div class="password-field-wrap">
            <input
              type="password"
              name="currentPassword"
              autocomplete="current-password"
              required
              placeholder="Current password"
            />
            <button
              type="button"
              class="password-toggle-btn"
              data-password-toggle
              aria-label="Show password"
            >
              Show
            </button>
          </div>
        </label>

        <label>
          
          
          New password


          <div class="password-field-wrap">
            <input
              type="password"
              name="newPassword"
              autocomplete="new-password"
              minlength="14"
              required
              placeholder="New password (minimum 14 characters)"
            />
            <button
              type="button"
              class="password-toggle-btn"
              data-password-toggle
              aria-label="Show password"
            >
              Show
            </button>
          </div>
        </label>

        <div style="margin-top: 12px; padding-top: 16px; border-top: 1px solid var(--line-subtle);">
          <button class="button primary" type="submit">Update password</button>
        </div>
      </div>
    @end
  </div>
@end
