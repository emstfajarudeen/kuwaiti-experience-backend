@layouts.admin({
  title: 'Contact requests',
  active: 'contacts',
  adminName: admin.fullName,
})
  <div class="page-head">
    <div>
      <h1>Contact requests</h1>
    </div>
  </div>

  <section class="panel table-panel">
    <div class="panel-heading">
      <h2>Messages ({{ meta.total }})</h2>
    </div>
    @if(data && data.length)
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col" class="th-edit" aria-label="View"></th>
              <th scope="col">Visitor</th>
              <th scope="col">Inquiry Type</th>
              <th scope="col">Status</th>
              <th scope="col">Received (Kuwait)</th>
              <th scope="col" class="th-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            @each(contact in data)
              <tr>
                <td class="td-edit">
                  <a
                    href="/admin/contact-requests/{{ contact.id }}"
                    class="action-pencil-btn"
                    title="View request from {{ contact.full_name }}"
                    aria-label="View request from {{ contact.full_name }}"
                  >
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                      <path d="m15 5 4 4" />
                    </svg>
                  </a>
                </td>
                <td>
                  <div class="place-title-wrap">
                    <strong>{{ contact.full_name }}</strong>
                    <small>
                      {{ contact.email }}{{
                        contact.phone_number
                          ? ` · ${contact.phone_number}`
                          : ''
                      }}
                    </small>
                  </div>
                </td>
                <td>
                  @if(contact.inquiry_type)
                    <span class="type-chip" style="font-size: 11px; padding: 2px 6px;">
                      {{ contact.inquiry_type }}
                    </span>
                  @else
                    <span style="color: var(--muted); font-size: 13px;">General</span>
                  @end
                </td>
                <td>
                  <span
                    class="status {{
                      contact.status === 'resolved'
                        ? 'published'
                        : contact.status === 'in_progress'
                          ? 'draft'
                          : 'archived'
                    }}"
                  >
                    {{ contact.status.replace('_', ' ') }}
                  </span>
                </td>
                <td style="color: var(--muted); font-size: 13px;">{{ contact.created_at }}</td>
                <td class="td-actions">
                  <div class="row-menu" data-row-menu>
                    <button
                      type="button"
                      class="action-dots-btn"
                      aria-haspopup="true"
                      aria-expanded="false"
                      title="More actions"
                      aria-label="More actions for request from {{ contact.full_name }}"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="5" r="1.75" />
                        <circle cx="12" cy="12" r="1.75" />
                        <circle cx="12" cy="19" r="1.75" />
                      </svg>
                    </button>
                    <div class="row-menu-dropdown" role="menu">
                      <a
                        href="/admin/contact-requests/{{ contact.id }}"
                        class="row-menu-item"
                        role="menuitem"
                      >
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                          <circle cx="12" cy="12" r="3" />
                        </svg>
                        <span>View inquiry</span>
                      </a>
                    </div>
                  </div>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
      @if(meta.lastPage > 1)
        <div class="pagination-bar">
          <span class="pagination-info">Page {{ meta.currentPage }} of {{ meta.lastPage }}</span>
          <div class="pagination-nav">
            @if(meta.currentPage > 1)
              <a
                class="button secondary table-action"
                href="/admin/contact-requests?page={{ meta.currentPage - 1 }}"
              >
                Previous
              </a>
            @end
            @if(meta.currentPage < meta.lastPage)
              <a
                class="button secondary table-action"
                href="/admin/contact-requests?page={{ meta.currentPage + 1 }}"
              >
                Next
              </a>
            @end
          </div>
        </div>
      @end
    @else
      <div class="empty-state">
        <p>No contact inquiries received yet.</p>
      </div>
    @end
  </section>
@end
