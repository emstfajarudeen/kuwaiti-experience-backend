@layouts.admin({ title: 'Contact requests', active: 'contacts', adminName: admin.fullName })
  <div class="page-head"><div><h1>Contact requests</h1><p>{{ meta.total }} messages from visitors and customers.</p></div></div>
  <section class="panel table-panel">
    <div class="table-scroll"><table class="data-table"><thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Received</th><th></th></tr></thead><tbody>
    @each(contact in data)
      <tr><td>{{ contact.full_name }}</td><td>{{ contact.email }}</td><td>{{ contact.status }}</td><td>{{ contact.created_at }}</td><td><a href="/admin/contact-requests/{{ contact.id }}">Open message</a></td></tr>
    @else
      <tr><td colspan="5">No contact requests yet.</td></tr>
    @end
    </tbody></table></div>
    <div class="panel-heading">
      @if(meta.page > 1)
        <a href="/admin/contact-requests?page={{ meta.page - 1 }}">Previous</a>
      @end
      <span>Page {{ meta.page }} of {{ meta.last_page }}</span>
      @if(meta.page < meta.last_page)
        <a href="/admin/contact-requests?page={{ meta.page + 1 }}">Next</a>
      @end
    </div>
  </section>
@end
