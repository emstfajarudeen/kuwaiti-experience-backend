@layouts.admin({ title: 'Contact request', active: 'contacts', adminName: admin.fullName })
  <a class="back-link" href="/admin/contact-requests">← Back to contact inbox</a>

  <div class="page-head">
    <div>
      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <h1>{{ contact.full_name }}</h1>
        <span class="status {{ contact.status }}">{{ contact.status.replace('_', ' ') }}</span>
      </div>
      <p style="margin-top: 6px; font-size: 14px; color: var(--muted);">
        <a href="mailto:{{ contact.email }}" style="color: var(--navy); text-decoration: underline;">{{ contact.email }}</a>
        @if(contact.phone_number)
          · <a href="tel:{{ contact.phone_number }}" style="color: var(--navy);">{{ contact.phone_number }}</a>
        @end
        · Received {{ contact.created_at }}
      </p>
    </div>
  </div>

  <div class="content-grid">
    <section class="panel form-panel">
      @if(contact.inquiry_type)
        <div style="margin-bottom: 16px;">
          <span style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 4px;">Inquiry Type</span>
          <span class="type-chip">{{ contact.inquiry_type }}</span>
        </div>
      @end

      <span style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 8px;">Message</span>
      <div style="background: var(--surface-subtle); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 18px 20px; font-size: 15px; line-height: 1.6; color: var(--ink); white-space: pre-wrap;">{{ contact.message }}</div>
    </section>

    <!-- Status Management Aside -->
    <section class="panel form-panel">
      <h2>Status</h2>

      @form({ action: '/admin/contact-requests/' + contact.id + '/status', method: 'POST' })
        <div class="form-grid">
          <label for="status">
            Workflow status
            <select id="status" name="status">
              @each(status in ['new', 'in_progress', 'resolved'])
                <option value="{{ status }}" @if(status === contact.status) selected @end>
                  {{ status.replace('_', ' ') }}
                </option>
              @end
            </select>
          </label>

          <button type="submit" class="button primary" style="margin-top: 8px;">
            Save status
          </button>
        </div>
      @end
    </section>
  </div>
@end
