@layouts.admin({
  title: 'Saved',
  active: destination.active,
  adminName: admin.fullName,
})
  <section class="save-success panel" aria-labelledby="save-success-title">
    <div class="save-success-spinner" aria-hidden="true"></div>
    <h1 id="save-success-title" style="font-size: 24px; margin: 0 0 10px;">
      Your changes have been saved.
    </h1>
    <p role="status" style="color: var(--muted); font-size: 14px; margin-bottom: 24px;">
      Returning to
      {{ destination.label }}...
    </p>
    <a class="button primary" href="{{ destination.path }}">Return to {{ destination.label }}</a>
  </section>
  <script>
    window.setTimeout(() => window.location.assign('{{ destination.path }}'), 1800);
  </script>
@end
