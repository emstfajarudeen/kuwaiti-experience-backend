@let(hasForm = flashMessages.has('categoryForm'))
@let(form = flashMessages.get('categoryForm') || {})
@layouts.admin({ title: category ? 'Edit category' : 'New category', active: 'categories', adminName: admin.fullName })
  <a class="back-link" href="/admin/categories">← Back to categories</a>

  <div class="page-head">
    <div>
      <h1>{{ category ? (en?.name || category.slug) : 'Create category' }}</h1>
    </div>
  </div>

  @form({ action: category ? `/admin/categories/${category.id}/save` : '/admin/categories', method: 'POST', class: 'editor-grid' })
    <div class="editor-main">
      <section class="panel form-panel">
        <h2>Category details</h2>
        <div class="form-grid two" style="margin-top: 16px;">
          <label>
            Category type
            <select name="type" required>
              @each(type in types)
                <option
                  value="{{ type.code }}"
                  @if((form.type ?? category?.type ?? defaultType ?? '') === type.code)
                    selected
                  @end
                >
                  {{ type.name_en }}
                </option>
              @end
            </select>
          </label>

          <label>
            Display order
            <input
              name="sortOrder"
              type="number"
              value="{{ form.sortOrder ?? category?.sort_order ?? 0 }}"
              required
            />
          </label>

          <label>
            English name
            <input
              name="nameEn"
              value="{{ form.nameEn ?? en?.name ?? '' }}"
              required
              maxlength="160"
              placeholder="Landmarks"
            />
          </label>

          <label>
            Arabic name
            <input
              name="nameAr"
              dir="rtl"
              lang="ar"
              value="{{ form.nameAr ?? ar?.name ?? '' }}"
              maxlength="160"
              placeholder="معالم أثرية"
            />
          </label>

          <label class="full">
            URL slug
            <input
              name="slug"
              value="{{ form.slug ?? category?.slug ?? '' }}"
              required
              pattern="[a-z0-9]+(-[a-z0-9]+)*"
              maxlength="160"
              placeholder="landmarks"
            />
          </label>

          <div class="full">
            @let(isCategoryActive = hasForm ? form.active === 'on' : (!category || category.active))
            <label class="checkbox-line">
              <input
                name="active"
                type="checkbox"
                @if(isCategoryActive)
                  checked
                @end
              />
              Active
            </label>
          </div>
        </div>
      </section>
    </div>

    <aside class="editor-aside">
      <section class="panel form-panel actions-panel">
        <h2>Publishing</h2>
        <div class="save-controls-stack" style="margin-top: 16px;">
          <button class="button primary wide" type="submit">
            Save {{ category ? 'changes' : 'category' }}
          </button>
        </div>
      </section>
    </aside>
  @end

  @if(category)
    <section class="panel danger-zone-panel" style="max-width: 600px;">
      <h2>Danger zone</h2>
      <div style="margin-top: 14px;">
        @form({ action: `/admin/categories/${category.id}/delete`, method: 'POST', 'data-confirm': 'Delete this category? Places assigned to it will become uncategorized.' })
          <button class="button danger" type="submit">Delete category</button>
        @end
      </div>
    </section>
  @end
@end
