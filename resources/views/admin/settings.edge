@let(form = flashMessages.get('settingsForm') || {})
@layouts.admin({ title: 'Site settings', active: 'settings', adminName: admin.fullName })
  <div class="page-head">
    <div>
      <h1>Site settings</h1>
    </div>
  </div>
  @form({
    action: '/admin/settings',
    method: 'POST',
    enctype: 'multipart/form-data',
    class: 'editor-grid',
  })
    <div class="editor-main">
      <!--Brand Identity Section-->
      <section class="panel form-panel">
        <h2>Brand &amp; logo</h2>

        <div class="form-grid" style="margin-top: 16px;">
          <label>
            
            
            Brand name


            <input
              name="brandName"
              value="{{ form.brandName ?? settings?.brand_name ?? 'The Kuwaiti Experience' }}"
              required
            />
          </label>

          <div class="image-field" style="margin-top: 8px;">
            <span style="font-size: 13px; font-weight: 600; color: var(--ink-secondary);">
              Logo image
            </span>
            @if(logoImageUrl)
              <div style="margin: 8px 0;">
                <img
                  src="{{ logoImageUrl }}"
                  alt="Brand logo"
                  style="max-height: 80px; max-width: 260px; object-fit: contain; background: var(--navy-deep); padding: 8px 16px; border-radius: var(--radius-sm);"
                />
              </div>
            @end

            <div class="image-upload">
              <span style="display: block; font-weight: 600; margin-bottom: 6px;">
                {{ logoImageUrl ? 'Replace logo' : 'Upload logo' }}
              </span>
              <input
                type="file"
                name="logoImage"
                accept="image/jpeg,image/png,image/webp"
                aria-label="Logo image"
                data-image-upload
              />
            </div>
            @if(logoImageUrl)
              <label class="checkbox-line" style="margin-top: 8px;">
                <input type="checkbox" name="removeLogo" />
                
                
                Remove logo image


              </label>
            @end
          </div>
        </div>
      </section>
      <!--Contact & Headquarters Section-->
      <section class="panel form-panel">
        <h2>Contact &amp; channels</h2>

        <div class="form-grid two" style="margin-top: 16px;">
          <label>
            
            
            Direct phone number


            <input
              name="directPhoneNumber"
              type="tel"
              placeholder="+965XXXXXXXX"
              value="{{ form.directPhoneNumber ?? settings?.direct_phone_number ?? '' }}"
            />
          </label>
          <label>
            
            
            Direct phone description


            <input
              name="directPhoneDescription"
              maxlength="160"
              placeholder="Support"
              value="{{ form.directPhoneDescription ?? settings?.direct_phone_description ?? '' }}"
            />
          </label>
          <label>
            
            
            WhatsApp number


            <input
              name="whatsappNumber"
              type="tel"
              placeholder="+965XXXXXXXX"
              value="{{ form.whatsappNumber ?? settings?.whatsapp_number ?? '' }}"
            />
          </label>
          <label>
            
            
            WhatsApp description


            <input
              name="whatsappDescription"
              maxlength="160"
              placeholder="WhatsApp Assistance"
              value="{{ form.whatsappDescription ?? settings?.whatsapp_description ?? '' }}"
            />
          </label>
          <label class="full">
            
            
            Contact email


            <input
              name="contactEmail"
              type="email"
              placeholder="support@kuwaitiexperience.com"
              value="{{ form.contactEmail ?? settings?.contact_email ?? '' }}"
            />
          </label>
          <label>
            
            
            Headquarters name


            <input
              name="headquartersName"
              maxlength="160"
              placeholder="Kuwait City Headquarters"
              value="{{ form.headquartersName ?? settings?.headquarters_name ?? '' }}"
            />
          </label>
          <label>
            
            
            Headquarters address


            <input
              name="headquartersAddress"
              maxlength="300"
              placeholder="Kuwait City"
              value="{{ form.headquartersAddress ?? settings?.headquarters_address ?? '' }}"
            />
          </label>
          <label class="full">
            
            
            Headquarters map URL


            <input
              name="headquartersMapUrl"
              type="url"
              placeholder="https://maps.google.com/..."
              value="{{ form.headquartersMapUrl ?? settings?.headquarters_map_url ?? '' }}"
            />
          </label>
          <label class="full" style="margin-top: 8px;">
            
            
            Inquiry types


            <textarea
              name="contactInquiryTypes"
              rows="4"
              placeholder="General Feedback&#10;Partnership&#10;Venue Listing&#10;Support"
            >{{ form.contactInquiryTypes ?? contactInquiryTypes }}</textarea>
          </label>
        </div>
      </section>
      <!--Mobile Apps Section-->
      <section class="panel form-panel">
        <h2>App store links</h2>

        <div class="form-grid two" style="margin-top: 16px;">
          <label>
            
            
            App Store URL (iOS)


            <input
              name="appStoreUrl"
              type="url"
              placeholder="https://apps.apple.com/..."
              value="{{ form.appStoreUrl ?? settings?.app_store_url ?? '' }}"
            />
          </label>
          <label>
            
            
            Google Play URL (Android)


            <input
              name="playStoreUrl"
              type="url"
              placeholder="https://play.google.com/..."
              value="{{ form.playStoreUrl ?? settings?.play_store_url ?? '' }}"
            />
          </label>
        </div>
      </section>
    </div>
    <!--Aside Save Panel-->
    <aside class="editor-aside">
      <section class="panel form-panel actions-panel">
        <h2>Publishing</h2>
        <div class="save-controls-stack" style="margin-top: 16px;">
          <button class="button primary wide" type="submit">Save settings</button>
        </div>
      </section>
    </aside>
  @end
@end
