@layouts.admin({ title: 'Place preview', active: 'places', adminName: admin.fullName })
  <a class="back-link" href="/admin/places/{{ place.id }}/edit">← Back to editor</a>

  <div class="page-head">
    <div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <h1>{{ place.title }}</h1>
        <span class="status {{ status }}">{{ status }}</span>
      </div>
      <p>{{ place.address }}</p>
    </div>
    <div class="page-head-actions">
      <a class="button primary" href="/admin/places/{{ place.id }}/edit">Edit place</a>
    </div>
  </div>

  <div class="panel form-panel" style="max-width: 900px;">
    @if(place.cover)
      <div style="margin-bottom: 24px;">
        <img
          class="cover-preview"
          src="{{ place.cover.url }}"
          alt="Preview cover for {{ place.title }}"
          style="max-height: 380px;"
        />
      </div>
    @end

    <div
      style="font-size: 16px; font-weight: 600; color: var(--navy); margin-bottom: 16px; line-height: 1.5;"
    >
      {{ place.summary }}
    </div>
    @if(place.body)
      <div
        style="font-size: 15px; line-height: 1.7; color: var(--ink-secondary); margin-bottom: 28px; white-space: pre-wrap;"
      >
        {{ place.body }}
      </div>
    @end

    <section style="border-top: 1px solid var(--line); padding-top: 20px; margin-top: 20px;">
      <h2 style="font-size: 18px; margin-bottom: 14px;">Plan your visit</h2>
      <div class="form-grid two" style="font-size: 14px;">
        <div>
          <span
            style="color: var(--muted); display: block; font-size: 12px; font-weight: 700; text-transform: uppercase;"
          >
            Price
          </span>
          <strong>
            {{
              place.price.mode === 'unknown'
                ? 'Not supplied'
                : `${place.price.amount || ''} ${place.price.currency}`
            }}
          </strong>
        </div>
        <div>
          <span
            style="color: var(--muted); display: block; font-size: 12px; font-weight: 700; text-transform: uppercase;"
          >
            Hours
          </span>
          <strong>{{ place.hoursNote || 'Not supplied' }}</strong>
        </div>
        <div>
          <span
            style="color: var(--muted); display: block; font-size: 12px; font-weight: 700; text-transform: uppercase;"
          >
            Gallery
          </span>
          <strong>{{ place.gallery.length }} images attached</strong>
        </div>
        @if(place.slug)
          <div>
            <span
              style="color: var(--muted); display: block; font-size: 12px; font-weight: 700; text-transform: uppercase;"
            >
              Slug
            </span>
            <code>/places/{{ place.slug }}</code>
          </div>
        @end
      </div>
    </section>
    @if(place.gallery && place.gallery.length)
      <section style="border-top: 1px solid var(--line); padding-top: 20px; margin-top: 24px;">
        <h2 style="font-size: 18px; margin-bottom: 14px;">Gallery ({{ place.gallery.length }})</h2>
        <div
          style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px;"
        >
          @each(img in place.gallery)
            <div
              style="border: 1px solid var(--line); border-radius: var(--radius-sm); overflow: hidden; background: var(--ivory);"
            >
              <img
                src="{{ img.url }}"
                alt="{{ img.alt || '' }}"
                style="width: 100%; height: 120px; object-fit: cover;"
                loading="lazy"
              />
              @if(img.caption)
                <p style="padding: 6px 8px; margin: 0; font-size: 11px; color: var(--muted);">
                  {{ img.caption }}
                </p>
              @end
            </div>
          @end
        </div>
      </section>
    @end
  </div>
@end
