@let(form = flashMessages.get('placeForm') || {})
@layouts.admin({ title: place ? 'Edit place' : 'New place', active: 'places', adminName: admin.fullName })
  <a class="back-link" href="/admin/places">← Back to places</a>

  <div class="page-head">
    <div>
      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <h1>{{ place ? (en?.title || 'Edit place') : 'Create a new place' }}</h1>
        @if(place)
          <span class="status {{ place.status }}">{{ place.status }}</span>
        @end
      </div>
    </div>

    <div class="page-head-actions">
      @if(place)
        <a class="button secondary" href="/admin/places/{{ place.id }}/preview" target="_blank">
          Preview
        </a>
        <a class="button secondary" href="/admin/places/{{ place.id }}/explore">
          Explore details &amp; hours
        </a>
      @end
    </div>
  </div>

  @form({ action: place ? `/admin/places/${place.id}/save` : '/admin/places', method: 'POST', enctype: 'multipart/form-data', class: 'editor-grid' })
    <div class="editor-main">
      <!-- Essentials -->
      <section class="panel form-panel">
        <h2>Place details</h2>
        <div class="form-grid two" style="margin-top: 16px;">
          <label>
            Place type
            <select name="type" id="place-type-select" required>
              <option value="" @if(form.type !== undefined ? !form.type : !place) selected @end>Select a place type</option>
              @each(type in types)
                <option
                  value="{{ type.code }}"
                  @if(form.type !== undefined ? form.type === type.code : (place && place.type === type.code))
                    selected
                  @end
                >
                  {{ type.name_en }}
                </option>
              @end
            </select>
          </label>

          <label>
            Category
            <select name="categoryId" id="place-category-select">
              <option value="">Uncategorized</option>
              @each(category in categories)
                <option
                  value="{{ category.id }}"
                  data-type="{{ category.type }}"
                  @if(form.categoryId !== undefined ? String(form.categoryId) === String(category.id) : (place && place.category_id === category.id))
                    selected
                  @end
                >
                  {{ category.name_en || category.name || category.slug }}
                </option>
              @end
            </select>
          </label>

          <label>
            English title
            <input name="titleEn" value="{{ form.titleEn ?? en?.title ?? '' }}" maxlength="200" required placeholder="Kuwait Towers" />
          </label>

          <label>
            URL slug
            <input name="slug" value="{{ form.slug ?? place?.slug ?? '' }}" pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="160" placeholder="kuwait-towers" required />
          </label>

          <label class="full">
            Short summary
            <textarea name="summaryEn" rows="2" maxlength="500" required placeholder="A brief summary">{{ form.summaryEn ?? en?.summary ?? '' }}</textarea>
          </label>

          <label class="full">
            Address
            <input name="addressEn" value="{{ form.addressEn ?? en?.address ?? '' }}" maxlength="300" required placeholder="Arabian Gulf Street, Sharq, Kuwait City" />
          </label>

          <label class="full">
            About this place
            <textarea name="bodyEn" rows="7" maxlength="30000" placeholder="Detailed description...">{{ form.bodyEn ?? en?.body ?? '' }}</textarea>
          </label>
        </div>
      </section>

      <!-- Arabic Content -->
      <section class="panel form-panel">
        <h2>Arabic translation</h2>
        <div class="form-grid two" style="margin-top: 16px;">
          <label>
            Arabic title
            <input name="titleAr" lang="ar" dir="rtl" value="{{ form.titleAr ?? ar?.title ?? '' }}" placeholder="أبراج الكويت" />
          </label>

          <label>
            Arabic address
            <input name="addressAr" lang="ar" dir="rtl" value="{{ form.addressAr ?? ar?.address ?? '' }}" placeholder="شارع الخليج العربي، الشرق" />
          </label>

          <label class="full">
            Arabic summary
            <textarea name="summaryAr" lang="ar" dir="rtl" rows="2">{{ form.summaryAr ?? ar?.summary ?? '' }}</textarea>
          </label>

          <label class="full">
            Arabic body
            <textarea name="bodyAr" lang="ar" dir="rtl" rows="5">{{ form.bodyAr ?? ar?.body ?? '' }}</textarea>
          </label>
        </div>
      </section>

      <!-- Visit Information -->
      <section class="panel form-panel">
        <h2>Visit information</h2>
        <div class="form-grid two" style="margin-top: 16px;">
          <label>
            Price type
            <select name="priceMode">
              @let(currentPriceMode = form.priceMode ?? place?.price_mode ?? 'unknown')
              <option value="unknown" @if(currentPriceMode === 'unknown') selected @end>Unknown / Contact venue</option>
              <option value="free" @if(currentPriceMode === 'free') selected @end>Free admission</option>
              <option value="from" @if(currentPriceMode === 'from') selected @end>Starts from</option>
              <option value="fixed" @if(currentPriceMode === 'fixed') selected @end>Fixed price</option>
            </select>
          </label>

          <label>
            Price in KWD
            <input name="priceAmount" inputmode="decimal" placeholder="3.000" value="{{ form.priceAmount ?? place?.price_amount ?? '' }}" />
          </label>

          <label>
            Price unit
            <input name="priceUnitEn" placeholder="per person / per night" value="{{ form.priceUnitEn ?? en?.price_unit ?? '' }}" />
          </label>

          <label>
            Hours summary
            <input name="hoursNoteEn" placeholder="Daily 9:00 AM – 11:00 PM" value="{{ form.hoursNoteEn ?? en?.hours_note ?? '' }}" />
          </label>

          <label>
            Latitude
            <input name="latitude" inputmode="decimal" placeholder="29.3897" value="{{ form.latitude ?? place?.latitude ?? '' }}" />
          </label>

          <label>
            Longitude
            <input name="longitude" inputmode="decimal" placeholder="47.9984" value="{{ form.longitude ?? place?.longitude ?? '' }}" />
          </label>

          <label class="full">
            Website URL
            <input name="websiteUrl" type="url" placeholder="https://example.com" value="{{ form.websiteUrl ?? place?.website_url ?? '' }}" />
          </label>
        </div>
      </section>

      <!-- Search & Homepage -->
      <section class="panel form-panel">
        <h2>Search &amp; homepage</h2>
        <div class="form-grid two" style="margin-top: 16px;">
          <label>
            SEO title
            <input name="seoTitleEn" value="{{ form.seoTitleEn ?? en?.seo_title ?? '' }}" placeholder="Kuwait Towers" />
          </label>

          <label>
            Home display order
            <input type="number" name="featured_order" min="0" max="9999" value="{{ form.featured_order ?? place?.featured_order ?? 0 }}" />
          </label>

          @let(isFeatured = form.featured ? form.featured === 'on' : Boolean(place && place.featured_order !== null))
          <div class="full">
            <label class="checkbox-line">
              <input
                name="featured"
