          <label class="full">
            SEO description
            <textarea name="seoDescriptionEn" rows="2">{{ form.seoDescriptionEn ?? en?.seo_description ?? '' }}</textarea>
          </label>
        </div>
      </section>

      <!-- Gallery -->
      <section class="panel form-panel">
        <h2>Gallery</h2>

        @if(gallery && gallery.length)
          <div class="gallery-editor" style="margin-top: 16px;">
            @each((image, index) in gallery)
              <article class="gallery-item">
                <img src="{{ image.url }}" alt="{{ image.alt_en || 'Gallery image' }}" loading="lazy" />
                <input type="hidden" name="gallery[{{ index }}][id]" value="{{ image.id }}" />
                <div class="form-grid two">
                  <label>
                    English alt
                    <input name="gallery[{{ index }}][altEn]" value="{{ image.alt_en || '' }}" maxlength="255" />
                  </label>
                  <label>
                    Arabic alt
                    <input name="gallery[{{ index }}][altAr]" lang="ar" dir="rtl" value="{{ image.alt_ar || '' }}" maxlength="255" />
                  </label>
                  <label>
                    English caption
                    <input name="gallery[{{ index }}][captionEn]" value="{{ image.caption_en || '' }}" maxlength="255" />
                  </label>
                  <label>
                    Arabic caption
                    <input name="gallery[{{ index }}][captionAr]" lang="ar" dir="rtl" value="{{ image.caption_ar || '' }}" maxlength="255" />
                  </label>
                  <label>
                    Order
                    <input name="gallery[{{ index }}][sortOrder]" type="number" min="0" max="999" value="{{ image.sort_order }}" />
                  </label>
                  <label class="checkbox-line">
                    <input type="checkbox" name="gallery[{{ index }}][remove]" />
                    Remove
                  </label>
                </div>
              </article>
            @end
          </div>
        @end

        <div class="form-grid" style="margin-top: 16px;">
          <div class="image-upload">
            <span style="display: block; font-weight: 600; margin-bottom: 6px;">Add gallery images:</span>
            <input
              type="file"
              name="galleryImages[]"
              multiple
              accept="image/jpeg,image/png,image/webp"
              aria-label="Add gallery images"
              data-image-upload
              data-max-files="{{ maxUploads }}"
            />
          </div>
          <label>
            Alt text for new images
            <input name="galleryAltEn" maxlength="255" placeholder="Kuwait Towers view" />
          </label>
        </div>
      </section>

      <!-- Explore Features & Hours -->
      <section class="panel form-panel">
        <h2>Explore &amp; weekly schedule</h2>

        @if(place)
          <div style="margin-top: 16px;">
            <a class="button secondary" href="/admin/places/{{ place.id }}/explore">
              Open Explore features &amp; hours editor
            </a>
          </div>
        @else
          <p style="margin-top: 12px; color: var(--muted); font-size: 13px;">
            Save this place first to configure its Explore amenities and weekly hours.
          </p>
        @end

        <details style="margin-top: 20px; border-top: 1px solid var(--line); padding-top: 16px;">
          <summary style="font-weight: 600; font-size: 13px; color: var(--muted); cursor: pointer;">
            Raw hours JSON
          </summary>
          <div style="margin-top: 10px;">
            <label>
              Structured weekly hours JSON
              <textarea name="hoursJson" rows="5" spellcheck="false" class="code-field">{{ form.hoursJson ?? hoursJson }}</textarea>
            </label>
          </div>
        </details>
      </section>
    </div>

    <!-- Aside Sidebar: Cover Image & Save Actions -->
    <aside class="editor-aside">
      <!-- Cover Image Panel -->
      <section class="panel form-panel">
        <h2>Cover image</h2>
        <div style="margin-top: 12px;">
          @if(coverUrl)
            <img class="cover-preview" src="{{ coverUrl }}" alt="Current cover" />
          @else
            <div class="cover-placeholder">No cover image uploaded</div>
          @end

          <div class="image-upload" style="margin-top: 12px;">
            <span style="display: block; font-weight: 600; margin-bottom: 6px;">
              {{ coverUrl ? 'Replace cover' : 'Upload cover' }}
            </span>
            <input
              type="file"
              name="coverImage"
              accept="image/jpeg,image/png,image/webp"
              aria-label="Cover image"
              data-image-upload
            />
          </div>

          @if(coverUrl && place?.status !== 'published')
            <label class="checkbox-line" style="margin-top: 10px;">
              <input type="checkbox" name="removeCover" /> Remove cover image
            </label>
          @end
        </div>
      </section>

      <!-- Save & Publish Panel -->
      <section class="panel form-panel actions-panel">
        <h2>Status &amp; actions</h2>

        <div class="save-controls-stack">
          @if(!place || place.status !== 'published')
            <button class="button secondary wide" type="submit" name="intent" value="save">
              Save {{ place ? 'changes' : 'draft' }}
            </button>
            <button class="button primary wide" type="submit" name="intent" value="publish">
              Save and publish
            </button>
          @else
            <button class="button primary wide" type="submit" name="intent" value="save">
              Save changes
            </button>
          @end
        </div>
      </section>
    </aside>
  @end

  <!-- Manage Place: Archive & Delete Actions -->
  @if(place)
    <section class="panel danger-zone-panel">
      <h2>Danger zone</h2>

      <div class="danger-zone-actions">
        <a class="button secondary" href="/admin/places/{{ place.id }}/preview" target="_blank">
          Preview
        </a>

        @if(place.status === 'published')
          @form({ action: `/admin/places/${place.id}/archive`, method: 'POST' })
            <button class="button secondary" type="submit">Archive place</button>
          @end
        @end

        @form({ action: `/admin/places/${place.id}/delete`, method: 'POST', 'data-confirm': 'Permanently delete this place?' })
          <button class="button danger" type="submit">Delete permanently</button>
        @end
      </div>
    </section>
  @end

  <script>
    (function () {
      const typeSelect = document.getElementById('place-type-select');
      const categorySelect = document.getElementById('place-category-select');
      if (!typeSelect || !categorySelect) return;

      const allOptions = Array.from(categorySelect.options).map(function (opt) {
        return {
          value: opt.value,
          text: opt.textContent.trim(),
          type: opt.getAttribute('data-type') || '',
        };
      });

      function syncCategories() {
        const selectedType = typeSelect.value;
        const currentSelectedValue = categorySelect.value;

        categorySelect.innerHTML = '';
        var matchedCurrent = false;

        allOptions.forEach(function (opt) {
          if (!opt.value || !selectedType || opt.type === selectedType) {
            const optionEl = document.createElement('option');
            optionEl.value = opt.value;
            optionEl.textContent = opt.text;
            if (opt.type) {
              optionEl.setAttribute('data-type', opt.type);
            }
            if (opt.value === currentSelectedValue) {
              optionEl.selected = true;
              matchedCurrent = true;
            }
            categorySelect.appendChild(optionEl);
          }
        });

        if (!matchedCurrent && currentSelectedValue) {
          categorySelect.value = '';
        }
      }

      typeSelect.addEventListener('change', syncCategories);
      syncCategories();
    })();
  </script>
@end
