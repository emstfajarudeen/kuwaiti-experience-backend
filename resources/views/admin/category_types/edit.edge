@let(hasForm = flashMessages.has('categoryTypeForm'))
@let(form = flashMessages.get('categoryTypeForm') || {})
@layouts.admin({
  title: categoryType ? 'Edit category type' : 'New category type',
  active: 'category-types',
  adminName: admin.fullName,
})
  <a class="back-link" href="/admin/category-types">← Back to category types</a>

  <div class="page-head">
    <div>
      <h1>{{ categoryType ? categoryType.name_en : 'Create category type' }}</h1>
    </div>
  </div>
  @form({
    action: categoryType
      ? `/admin/category-types/${categoryType.code}/save`
      : '/admin/category-types',
    method: 'POST',
    enctype: 'multipart/form-data',
    class: 'editor-grid',
  })
    <div class="editor-main">
      <section class="panel form-panel">
        <h2>Type details</h2>

        <div class="form-grid two" style="margin-top: 16px;">
          @if(!categoryType)
            <label>
              
              
              Code


              <input
                name="code"
                value="{{ form.code ?? '' }}"
                required
                maxlength="32"
                pattern="[a-z0-9]+(_[a-z0-9]+)*"
                placeholder="museum"
              />
            </label>
          @else
            <label>
              
              
              Code


              <input
                value="{{ categoryType.code }}"
                readonly
                style="background: var(--ivory); color: var(--muted);"
              />
            </label>
          @end

          <label>
            
            
            Display order


            <input
              name="sortOrder"
              type="number"
              value="{{ form.sortOrder ?? categoryType?.sort_order ?? nextOrder }}"
              required
            />
          </label>

          <label>
            
            
            English name


            <input
              name="nameEn"
              value="{{ form.nameEn ?? categoryType?.name_en ?? '' }}"
              required
              maxlength="160"
              placeholder="Museums"
            />
          </label>

          <label>
            
            
            Arabic name


            <input
              name="nameAr"
              dir="rtl"
              lang="ar"
              value="{{ form.nameAr ?? categoryType?.name_ar ?? '' }}"
              maxlength="160"
              placeholder="المتاحف"
            />
          </label>
          <!--Tile Image Field-->
          <div class="full image-field" style="margin-top: 8px;">
            <span style="font-size: 13px; font-weight: 600; color: var(--ink-secondary);">
              Tile image
            </span>
            @if(imageUrl)
              <div style="margin: 8px 0;">
                <img
                  src="{{ imageUrl }}"
                  alt="{{ categoryType.name_en }}"
                  style="max-width: 240px; height: 140px; border-radius: var(--radius-sm); object-fit: cover; border: 1px solid var(--line);"
                />
              </div>
            @end

            <div class="image-upload" style="margin-top: 8px;">
              <span style="display: block; font-weight: 600; margin-bottom: 6px;">
                {{ imageUrl ? 'Replace tile image' : 'Upload tile image' }}
              </span>
              <input
                type="file"
                name="image"
                accept="image/jpeg,image/png,image/webp"
                aria-label="Tile image"
                data-image-upload
              />
            </div>
            @if(imageUrl)
              <label class="checkbox-line" style="margin-top: 8px;">
                <input type="checkbox" name="removeImage" />
                
                
                Remove tile image


              </label>
            @end
          </div>
        </div>
      </section>
    </div>

    <aside class="editor-aside">
      <section class="panel form-panel actions-panel">
        <h2>Publishing</h2>
        <div class="save-controls-stack" style="margin-top: 16px;">
          <button class="button primary wide" type="submit">
            Save
            {{ categoryType ? 'changes' : 'category type' }}
          </button>
        </div>
      </section>
    </aside>
  @end
  @if(categoryType)
    <section class="panel danger-zone-panel" style="max-width: 600px;">
      <h2>Danger zone</h2>
      <div style="margin-top: 14px;">
        @form({
          action: `/admin/category-types/${categoryType.code}/delete`,
          method: 'POST',
          'data-confirm':
            'Delete this category type? Ensure no places or categories use it first.',
        })
          <button class="button danger" type="submit">Delete category type</button>
        @end
      </div>
    </section>
  @end
@end
