@layouts.admin({
  title: 'Category types',
  active: 'category-types',
  adminName: admin.fullName,
})
  <div class="page-head">
    <div>
      <h1>Category types</h1>
    </div>
    <div class="page-head-actions">
      <a class="button primary" href="/admin/category-types/new">+ Add category type</a>
    </div>
  </div>

  <section class="panel table-panel">
    <div class="panel-heading">
      <h2>Category types ({{ rows.length }})</h2>
    </div>
    @if(rows && rows.length)
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Type</th>
              <th scope="col">Arabic name</th>
              <th scope="col">Display order</th>
              <th scope="col">Tile image</th>
              <th scope="col" style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            @each(item in rows)
              <tr>
                <td>
                  <div class="place-title-wrap">
                    <strong>{{ item.name_en }}</strong>
                    <small><code>{{ item.code }}</code></small>
                  </div>
                </td>
                <td style="font-size: 14px;" dir="rtl">{{ item.name_ar || '—' }}</td>
                <td style="font-weight: 600; color: var(--muted);">{{ item.sort_order }}</td>
                <td>
                  @if(item.image_key)
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <img
                        src="{{ item.imageUrl }}"
                        alt="{{ item.name_en }}"
                        style="width: 48px; height: 32px; object-fit: cover; border-radius: var(--radius-sm);"
                      />
                    </div>
                  @else
                    <span style="color: var(--muted); font-size: 13px;">—</span>
                  @end
                </td>
                <td style="text-align: right;">
                  <a
                    class="button secondary table-action"
                    href="/admin/category-types/{{ item.code }}/edit"
                  >
                    Edit
                  </a>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      <div class="empty-state">
        <p>No category types configured.</p>
        <a href="/admin/category-types/new">Create category type</a>
      </div>
    @end
  </section>
@end
