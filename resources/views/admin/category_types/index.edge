@layouts.admin({
  title: 'Category types',
  active: 'category-types',
  adminName: admin.fullName,
})
  <div class="page-head">
    <div>
      <h1>Category types</h1>
    </div>
    <div class="page-head-actions">
      <a class="button primary" href="/admin/category-types/new">+ Add category type</a>
    </div>
  </div>

  <section class="panel table-panel">
    <div class="panel-heading">
      <h2>Category types ({{ rows.length }})</h2>
    </div>
    @if(rows && rows.length)
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col" class="th-edit" aria-label="Edit"></th>
              <th scope="col">Type</th>
              <th scope="col">Arabic name</th>
              <th scope="col">Display order</th>
              <th scope="col" class="th-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            @each(item in rows)
              <tr>
                <td class="td-edit">
                  <a
                    href="/admin/category-types/{{ item.code }}/edit"
                    class="action-pencil-btn"
                    title="Edit {{ item.name_en }}"
                    aria-label="Edit {{ item.name_en }}"
                  >
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                      <path d="m15 5 4 4" />
                    </svg>
                  </a>
                </td>
                <td>
                  <div style="display: flex; align-items: center; gap: 12px;">
                    @if(item.image_key)
                      <img
                        src="{{ item.imageUrl || '/admin/images/' + item.image_key }}"
                        alt="{{ item.name_en }}"
                        style="width: 44px; height: 44px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--line); flex-shrink: 0;"
                      />
                    @else
                      <div
                        class="place-avatar"
                        aria-hidden="true"
                        style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--navy-surface); color: var(--navy); display: grid; place-items: center; font-weight: 700; font-size: 14px; flex-shrink: 0;"
                      >
                        {{
                          (item.name_en || item.code)
                            .slice(0, 1)
                            .toUpperCase()
                        }}
                      </div>
                    @end

                    <div class="place-title-wrap">
                      <strong>{{ item.name_en }}</strong>
                      <small><code>{{ item.code }}</code></small>
                    </div>
                  </div>
                </td>
                <td style="font-size: 14px;" dir="rtl">{{ item.name_ar || '—' }}</td>
                <td style="font-weight: 600; color: var(--muted);">{{ item.sort_order }}</td>
                <td class="td-actions">
                  <div class="row-menu" data-row-menu>
                    <button
                      type="button"
                      class="action-dots-btn"
                      aria-haspopup="true"
                      aria-expanded="false"
                      title="More actions"
                      aria-label="More actions for {{ item.name_en }}"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="5" r="1.75" />
                        <circle cx="12" cy="12" r="1.75" />
                        <circle cx="12" cy="19" r="1.75" />
                      </svg>
                    </button>
                    <div class="row-menu-dropdown" role="menu">
                      @form({
                        action: `/admin/category-types/${item.code}/delete`,
                        method: 'POST',
                        'data-confirm': `Are you sure you want to delete category type "${item.name_en}"? Any categories under this type should be reassigned first.`,
                        'data-confirm-title': 'Delete category type',
                        'data-confirm-btn': 'Delete',
                        'data-confirm-variant': 'danger',
                      })
                        <button type="submit" class="row-menu-item danger" role="menuitem">
                          <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M3 6h18" />
                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                            <line x1="10" x2="10" y1="11" y2="17" />
                            <line x1="14" x2="14" y1="11" y2="17" />
                          </svg>
                          <span>Delete</span>
                        </button>
                      @end
                    </div>
                  </div>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      <div class="empty-state">
        <p>No category types configured.</p>
        <a href="/admin/category-types/new">Create category type</a>
      </div>
    @end
  </section>
@end
