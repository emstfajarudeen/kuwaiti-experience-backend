<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin sign in · The Kuwaiti Experience</title>
    @vite(['resources/css/admin.css', 'resources/js/app.js'])
  </head>
  <body class="login-body">
    <main class="login-shell">
      <section class="login-visual" aria-label="Brand">
        <div>
          <div class="login-brand">THE KUWAITI EXPERIENCE</div>
        </div>

        <div>
          <h1>Admin Portal</h1>
        </div>
      </section>

      <section class="login-panel">
        <h2>Welcome back</h2>
        @if(flashMessages.has('loginError'))
          <div class="notice error" role="alert" style="margin-bottom: 20px;">
            <span class="notice-icon" aria-hidden="true">⚠</span>
            <div class="notice-body">{{ flashMessages.get('loginError') }}</div>
          </div>
        @end
        @form({ action: '/admin/login', method: 'POST', class: 'editor-form' })
          <div class="form-grid" style="gap: 18px;">
            <label>
              
              
              Email address


              <input
                type="email"
                name="email"
                autocomplete="username"
                required
                value="{{ flashMessages.get('email') || '' }}"
                placeholder="name@example.com"
              />
            </label>
            <label>
              
              
              Password


              <div class="password-field-wrap">
                <input
                  type="password"
                  name="password"
                  autocomplete="current-password"
                  required
                  placeholder="••••••••••••"
                />
                <button
                  type="button"
                  class="password-toggle-btn"
                  data-password-toggle
                  aria-label="Show password"
                >
                  Show
                </button>
              </div>
            </label>
            <button class="button primary wide" type="submit" style="margin-top: 8px;">
              Sign in
            </button>
          </div>
        @end
        @if(canRefresh)
          <div style="margin-top: 16px; text-align: center;">
            @form({ action: '/admin/refresh', method: 'POST', class: 'continue-form' })
              <button class="text-button" type="submit">Continue previous session</button>
            @end
          </div>
        @end
      </section>
    </main>
  </body>
</html>
