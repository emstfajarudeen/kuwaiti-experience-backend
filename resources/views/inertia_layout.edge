<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Kuwaiti Experience" />
    <meta property="og:title" content="The Kuwaiti Experience · Content Studio" />
    <meta property="og:description" content="The content management studio for The Kuwaiti Experience." />
    <meta property="og:url" content="{{ page.props.cmsSocial.url }}" />
    <meta property="og:image" content="{{ page.props.cmsSocial.image }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Kuwaiti Experience Content Studio" />
    <meta name="twitter:card" content="summary_large_image" />
    @inertiaHead()
    @vite(['resources/css/admin.css', 'resources/css/cms-tailwind.css', 'inertia/app.tsx'])
  </head>
  <body class="{{ bodyClass ?? 'cms-body' }}">
    @inertia()
  </body>
</html>
